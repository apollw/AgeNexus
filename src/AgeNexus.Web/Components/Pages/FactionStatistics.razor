@page "/estatisticas/civilizacoes"
@inject AgeNexus.Application.Queries.IStatisticsQueryService Statistics

<PageTitle>Civilizações · Age Nexus</PageTitle>

<section class="page-heading compact-heading">
    <div><span class="eyebrow">Metagame da comunidade</span><h1>Civilizações</h1><p>Ranking, uso e aproveitamento calculados somente em partidas validadas.</p></div>
</section>

@if (Factions.Count == 0)
{
    <section class="panel table-panel">
        <div class="panel-empty page-empty"><strong>Ainda não há amostra suficiente</strong></div>
    </section>
}
else
{
    <section class="faction-podium" aria-label="Civilizações mais bem colocadas">
        @foreach (var rankedFaction in Factions.Take(3).Select((faction, index) => new { Faction = faction, Rank = index + 1 }))
        {
            <article class="panel faction-podium-card faction-rank-@rankedFaction.Rank">
                <span class="faction-rank-badge">#@rankedFaction.Rank</span>
                @if (rankedFaction.Faction.ImageUrl is not null)
                {
                    <img src="@rankedFaction.Faction.ImageUrl" alt="" width="104" height="104" />
                }
                <div>
                    <span class="eyebrow">Índice @rankedFaction.Faction.StrengthIndex.ToString("0.##")</span>
                    <h2>@rankedFaction.Faction.Name</h2>
                    <p>@rankedFaction.Faction.Victories vitória(s) em @rankedFaction.Faction.Uses partida(s)</p>
                </div>
            </article>
        }
    </section>

    <section class="panel table-panel faction-table-panel">
        <div class="faction-ranking-note">
            <strong>Ranking de força</strong>
            <span>O índice considera vitórias, empates e a confiança da amostra. Quanto mais partidas, mais confiável é a colocação.</span>
        </div>
        <div class="data-table mobile-card-table faction-mobile-table">
            <div class="table-head faction-table-row"><span>Pos.</span><span>Civilização</span><span>Usos</span><span>Vitórias</span><span>Derrotas</span><span>Aproveitamento</span><span>Índice</span></div>
            @foreach (var rankedFaction in VisibleFactions)
            {
                <div class="table-row faction-table-row">
                    <strong class="faction-position" data-label="Posição">#@rankedFaction.Rank</strong>
                    <span class="faction-name-cell" data-label="Civilização">
                        @if (rankedFaction.Faction.ImageUrl is not null)
                        {
                            <img src="@rankedFaction.Faction.ImageUrl" alt="" width="104" height="104" loading="lazy" />
                        }
                        <strong>@rankedFaction.Faction.Name</strong>
                    </span>
                    <span data-label="Usos">@rankedFaction.Faction.Uses</span>
                    <span data-label="Vitórias">@rankedFaction.Faction.Victories</span>
                    <span data-label="Derrotas">@rankedFaction.Faction.Defeats</span>
                    <span data-label="Aproveitamento">@rankedFaction.Faction.WinRate.ToString("0.##")%</span>
                    <strong class="faction-strength" data-label="Índice">@rankedFaction.Faction.StrengthIndex.ToString("0.##")</strong>
                </div>
            }
        </div>
    </section>
    <PaginationNav CurrentPage="@CurrentPage" TotalItems="@Factions.Count" PageSize="@PageSize" BasePath="/estatisticas/civilizacoes" />
}

@code {
    private const int PageSize = 12;
    [SupplyParameterFromQuery(Name = "pagina")] private int Page { get; set; } = 1;
    private IReadOnlyCollection<AgeNexus.Application.Queries.FactionStatistics> Factions { get; set; } = [];
    private int CurrentPage => Math.Clamp(Page, 1, Math.Max(1, (int)Math.Ceiling(Factions.Count / (double)PageSize)));
    private IEnumerable<RankedFaction> VisibleFactions => Factions
        .Select((faction, index) => new RankedFaction(faction, index + 1))
        .Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnParametersSetAsync() => Factions = await Statistics.GetFactionStatisticsAsync();

    private sealed record RankedFaction(AgeNexus.Application.Queries.FactionStatistics Faction, int Rank);
}
