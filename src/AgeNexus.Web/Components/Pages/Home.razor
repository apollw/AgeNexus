                            </InputSelect>
                        </label>
                        @if (participant.Type == AgeNexus.Domain.Matches.ParticipantType.Human)
                        {
                            <label class="form-field"><span>Jogador</span>
                                <InputSelect @bind-Value="participant.PlayerProfileId">
                                    @foreach (var option in Catalog.Players) { <option value="@option.Id">@option.Name</option> }
                                </InputSelect>
                            </label>
                        }
                        else
                        {
                            <label class="form-field"><span>Dificuldade</span>
                                <InputSelect @bind-Value="participant.AiDifficultyId">
                                    @foreach (var option in Catalog.AiDifficulties) { <option value="@option.Id">@option.Name</option> }
                                </InputSelect>
                            </label>
                        }
                        <label class="form-field"><span>CivilizaÃ§Ã£o</span>
                            <InputSelect @bind-Value="participant.FactionId">
                                <option value="">AleatÃ³ria ou desconhecida</option>
                                @foreach (var option in Catalog.Factions) { <option value="@option.Id">@option.Name</option> }
                            </InputSelect>
                        </label>
                        <button class="button button-secondary" type="button" @onclick="() => RemoveParticipant(team, participant)" disabled="@(team.Participants.Count <= 1)">Remover</button>
                    </div>
                }
                <button class="button button-secondary" type="button" @onclick="() => AddParticipant(team)">+ Participante</button>
            </section>
        }

        @if (Form.Type == AgeNexus.Domain.Matches.MatchType.FreeForAll)
        {
            <section class="panel match-team-adder">
                <div>
                    <strong>@Form.Teams.Count de @AgeNexus.Domain.Matches.Match.MaximumTeams equipes</strong>
                    <span>O formato Ã© montado automaticamente, como 1x1x1. Partidas multiequipe ainda nÃ£o alteram o Elo.</span>
                </div>
                <button class="button button-secondary" type="button" @onclick="AddTeam" disabled="@(Form.Teams.Count >= AgeNexus.Domain.Matches.Match.MaximumTeams)">+ Adicionar equipe</button>
            </section>
        }

        <button class="button button-primary account-submit" type="submit" disabled="@Saving">
            @(Saving ? "Registrando..." : "Registrar e solicitar confirmaÃ§Ã£o")
        </button>
    </EditForm>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private AgeNexus.Application.Queries.MatchRegistrationCatalog? Catalog { get; set; }
    private AgeNexus.Infrastructure.Identity.PublicProfile? CurrentProfile { get; set; }
    private MatchForm Form { get; } = new();
    private CatalogSetupForm SetupForm { get; } = new();
    private string? Error { get; set; }
    private string? SetupError { get; set; }
    private bool Saving { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool SettingUpCatalog { get; set; }
    private bool SyncingCatalog { get; set; }
    private bool ChangingEdition { get; set; }
    private bool CatalogSyncFailed { get; set; }
    private string? CatalogMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authentication = await AuthenticationStateTask;
            CurrentProfile = await Accounts.GetProfileAsync(authentication.User, CancellationToken.None);
            Catalog = await CatalogQueries.GetMatchRegistrationCatalogAsync();
            InitializeMatchForm();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void InitializeMatchForm(Guid? preferredEditionId = null)
    {
        if (Catalog is null || CurrentProfile is null || Form.Teams.Count > 0)
        {
            return;
        }

        var edition = Catalog.GameEditions.FirstOrDefault(x => x.Id == preferredEditionId) ??
                      Catalog.GameEditions.FirstOrDefault();
        if (edition is null)
        {
            return;
        }

        Form.GameEditionId = edition.Id;
        Form.Teams.Add(CreateTeam(AgeNexus.Domain.Matches.TeamResult.Victory, CurrentProfile.Id));
        var opponent = Catalog.Players.FirstOrDefault(x => x.Id != CurrentProfile.Id)?.Id ?? CurrentProfile.Id;
        Form.Teams.Add(CreateTeam(AgeNexus.Domain.Matches.TeamResult.Defeat, opponent));
    }

    private async Task SetupCatalogAsync()
    {
        var authentication = await AuthenticationStateTask;
        if (!await Accounts.IsAdministratorAsync(authentication.User))
        {
            SetupError = "Sua conta nÃ£o possui permissÃ£o para alterar os dados do jogo.";
            return;
        }

        SettingUpCatalog = true;
        SetupError = null;
        try
        {
            var result = await CatalogSetup.InitializeAsync(SetupForm.GameName, SetupForm.EditionName);
            if (!result.Succeeded)
            {
                SetupError = result.ErrorCode switch
                {
                    "AlreadyInitialized" or "ConcurrentSetup" => "O jogo foi configurado em outra sessÃ£o. Atualize a pÃ¡gina.",
                    _ => "Informe nomes vÃ¡lidos, com no mÃ¡ximo 120 caracteres."
                };
                return;
            }

            Catalog = await CatalogQueries.GetMatchRegistrationCatalogAsync(result.GameEditionId);
            InitializeMatchForm(result.GameEditionId);
        }
        finally
        {
            SettingUpCatalog = false;
        }
    }

    private async Task SyncAge2CatalogAsync()
    {
        var authentication = await AuthenticationStateTask;
        if (!await Accounts.IsAdministratorAsync(authentication.User))
        {
            SetupError = "Sua conta nÃ£o possui permissÃ£o para alterar os dados do jogo.";
            return;
        }

        SyncingCatalog = true;
        CatalogSyncFailed = false;
        CatalogMessage = null;
        try
        {
            var result = await CatalogSetup.SyncAge2DefinitiveEditionAsync(Form.GameEditionId);
            CatalogSyncFailed = !result.Succeeded;
            CatalogMessage = result.Succeeded
                ? $"Dados atualizados: {result.TotalCivilizations} civilizaÃ§Ãµes, {result.TotalMaps} mapas e {result.TotalAiDifficulties} dificuldades de IA disponÃ­veis."
                : "NÃ£o foi possÃ­vel carregar os dados do jogo. Atualize a pÃ¡gina e tente novamente.";
            if (result.Succeeded)
            {
                Catalog = await CatalogQueries.GetMatchRegistrationCatalogAsync(Form.GameEditionId);
            }
        }
        finally
        {
            SyncingCatalog = false;
        }
    }

    private async Task EditionChangedAsync()
    {
        ChangingEdition = true;
        Form.MapDefinitionId = null;
        Form.GamePatchId = null;
        foreach (var participant in Form.Teams.SelectMany(x => x.Participants))
        {
            participant.FactionId = null;
            participant.AiDifficultyId = null;
        }

        try
        {
            Catalog = await CatalogQueries.GetMatchRegistrationCatalogAsync(Form.GameEditionId);
        }
        finally
        {
            ChangingEdition = false;
        }
    }

    private TeamForm CreateTeam(AgeNexus.Domain.Matches.TeamResult result, Guid playerId)
    {
        var team = new TeamForm { Result = result };
        team.Participants.Add(CreateParticipant(playerId));
        return team;
    }

    private ParticipantForm CreateParticipant(Guid? playerId = null) => new()
    {
        PlayerProfileId = playerId ?? Catalog?.Players.FirstOrDefault()?.Id,
        AiDifficultyId = Catalog?.AiDifficulties.FirstOrDefault()?.Id
    };

    private void AddParticipant(TeamForm team) => team.Participants.Add(CreateParticipant());

    private bool CanRemoveTeam => Form.Teams.Count >
        (Form.Type == AgeNexus.Domain.Matches.MatchType.FreeForAll ? 3 : 2);

    private void MatchTypeChanged()
    {
        if (Form.Type == AgeNexus.Domain.Matches.MatchType.FreeForAll)
        {
            while (Form.Teams.Count < 3)
            {
                AddTeam();
            }
        }
    }

    private void AddTeam()
    {
        if (Form.Teams.Count >= AgeNexus.Domain.Matches.Match.MaximumTeams)
        {
            return;
        }

        var selectedPlayers = Form.Teams
            .SelectMany(x => x.Participants)
            .Where(x => x.Type == AgeNexus.Domain.Matches.ParticipantType.Human && x.PlayerProfileId.HasValue)
            .Select(x => x.PlayerProfileId!.Value)
            .ToHashSet();
        var availablePlayer = Catalog?.Players.FirstOrDefault(x => !selectedPlayers.Contains(x.Id));
        var participant = CreateParticipant(availablePlayer?.Id);
        if (availablePlayer is null)
        {
            participant.Type = AgeNexus.Domain.Matches.ParticipantType.ArtificialIntelligence;
            participant.PlayerProfileId = null;
        }

        var team = new TeamForm { Result = AgeNexus.Domain.Matches.TeamResult.Defeat };
        team.Participants.Add(participant);
        Form.Teams.Add(team);
    }

    private void RemoveTeam(TeamForm team)
    {
        if (!CanRemoveTeam)
        {
            return;
        }

        var removedWinner = team.Result == AgeNexus.Domain.Matches.TeamResult.Victory;
        Form.Teams.Remove(team);
        if (removedWinner && Form.Teams.All(x => x.Result != AgeNexus.Domain.Matches.TeamResult.Victory))
        {
            Form.Teams[0].Result = AgeNexus.Domain.Matches.TeamResult.Victory;
        }
    }

    private static void RemoveParticipant(TeamForm team, ParticipantForm participant)
    {
        if (team.Participants.Count > 1)
        {
            team.Participants.Remove(participant);
        }
    }

    private async Task SubmitAsync()
    {
        if (CurrentProfile is null)
        {
            return;
        }

        Saving = true;
        Error = null;
        var request = new AgeNexus.Application.Matches.RegisterMatchRequest(
            Form.GameEditionId,
            CurrentProfile.Id,
            DateTimeOffset.UtcNow,
            Form.Type,
            AgeNexus.Domain.Matches.MatchNature.Ranked,
            Form.GameMode,
            null,
            Form.MapDefinitionId,
            Form.GamePatchId,
            Form.Teams.Select(team => new AgeNexus.Application.Matches.RegisterMatchTeam(
                team.Result,
                team.Participants.Select(participant => new AgeNexus.Application.Matches.RegisterMatchParticipant(
                    participant.Type,
                    participant.PlayerProfileId,
                    participant.AiDifficultyId,
                    participant.FactionId,
                    participant.FactionId.HasValue
                        ? AgeNexus.Domain.Matches.FactionSelection.Manual
                        : AgeNexus.Domain.Matches.FactionSelection.Unknown)).ToArray())).ToArray());
        var result = await Workflow.RegisterAsync(request);
        Saving = false;
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/partidas/{result.MatchId}/desempenho?novo=1");
            return;
        }

        Error = result.ErrorCode switch
        {
            "NotAuthorized" => "sua conta nÃ£o possui permissÃ£o para registrar esta partida.",
            "InvalidMatch" => "revise as equipes, os participantes e o resultado informado.",
            _ => "ocorreu um problema inesperado. Revise os dados e tente novamente."
        };
    }

    private sealed class MatchForm
    {
        public Guid GameEditionId { get; set; }
        public AgeNexus.Domain.Matches.MatchType Type { get; set; } = AgeNexus.Domain.Matches.MatchType.PlayerVersusPlayer;
        public AgeNexus.Domain.Matches.MatchGameMode GameMode { get; set; } = AgeNexus.Domain.Matches.MatchGameMode.Standard;
        public Guid? MapDefinitionId { get; set; }
        public Guid? GamePatchId { get; set; }
        public List<TeamForm> Teams { get; } = [];
    }

    private sealed class CatalogSetupForm
    {
        [Required(ErrorMessage = "Informe o nome do jogo.")]
        [StringLength(120, ErrorMessage = "Use no mÃ¡ximo 120 caracteres.")]
        public string GameName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o nome da ediÃ§Ã£o.")]
        [StringLength(120, ErrorMessage = "Use no mÃ¡ximo 120 caracteres.")]
        public string EditionName { get; set; } = string.Empty;
    }

    private sealed class TeamForm
    {
        public AgeNexus.Domain.Matches.TeamResult Result { get; set; }
        public List<ParticipantForm> Participants { get; } = [];
    }

    private sealed class ParticipantForm
    {
        public AgeNexus.Domain.Matches.ParticipantType Type { get; set; }
        public Guid? PlayerProfileId { get; set; }
        public Guid? AiDifficultyId { get; set; }
        public Guid? FactionId { get; set; }
    }
