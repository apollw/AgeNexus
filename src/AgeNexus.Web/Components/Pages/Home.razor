<div class="dashboard-grid">
    <section class="panel matches-panel">
        <header class="panel-header">
            <div><span class="eyebrow">Ãšltimos confrontos</span><h2>Atividade recente</h2></div>
            <a href="/partidas">Ver todas <span>â†’</span></a>
        </header>

        @if (RecentMatches.Count == 0)
        {
            <div class="panel-empty">
                <span class="empty-icon">âš”</span>
                <strong>Nenhuma partida registrada</strong>
                <p>As partidas reais da comunidade aparecerÃ£o aqui.</p>
            </div>
        }
        else
        {
            <div class="home-match-list">
                @foreach (var match in RecentMatches)
                {
                    <a class="home-match-row" href="/partidas/@match.MatchId">
                        <div class="home-match-meta">
                            <span class="status-badge @StatusClass(match.Status)">@StatusLabel(match.Status)</span>
                            <time datetime="@match.PlayedAtUtc.ToString("O")">@match.PlayedAtUtc.ToLocalTime().ToString("dd MMM Â· HH:mm")</time>
                        </div>
                        <div class="home-match-main">
                            <div class="home-match-teams">
                                @foreach (var team in match.Teams)
                                {
                                    <strong class="@(team.Result == AgeNexus.Domain.Matches.TeamResult.Victory ? "winner" : null)"><span>@TeamResultMark(team.Result)</span>@string.Join(" + ", team.Participants)</strong>
                                }
                            </div>
                            <span class="home-match-versus">VS</span>
                            <div class="home-match-context">
                                <b>@match.Format</b>
                                <small>@CategoryLabel(match.Type, match.Category)</small>
                            </div>
                            <span class="home-match-arrow">â†’</span>
                        </div>
                    </a>
                }
            </div>
        }
    </section>

