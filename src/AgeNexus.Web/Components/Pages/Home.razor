    <EditForm Model="Form" OnValidSubmit="SubmitAsync" class="account-form">
        <div class="panel profile-form-card">
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="form-alert form-alert-error">NÃ£o foi possÃ­vel registrar: @Error</div>
