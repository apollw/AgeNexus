@page "/rankings"
@inject AgeNexus.Application.Queries.IRankingQueryService RankingQueries

<PageTitle>Rankings · Age Nexus</PageTitle>

<section class="page-heading compact-heading">
    <div><span class="eyebrow">Competição</span><h1>Rankings</h1><p>Habilidade, carreira e domínio contra IA permanecem separados.</p></div>
</section>

@foreach (var board in Boards)
{
    <section class="panel table-panel ranking-board">
        <header class="panel-header"><div><span class="eyebrow">@board.Key</span><h2>@GetDescription(board.Key)</h2></div></header>
        @if (board.Value.Count == 0)
        {
            <div class="panel-empty panel-empty-compact"><strong>Nenhum participante elegível</strong></div>
        }
        else
        {
            <div class="data-table">
                <div class="table-head"><span>Posição</span><span>Participante</span><span>Pontuação</span><span>Partidas</span><span>Situação</span></div>
                @foreach (var entry in board.Value)
                {
                    <div class="table-row">
                        <span>#@entry.Position</span><span>@entry.DisplayName</span><span>@entry.Score.ToString("0.##")</span>
                        <span>@entry.ValidatedMatches</span><span>@(entry.IsProvisional ? "Provisório" : "Classificado")</span>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private Dictionary<string, IReadOnlyCollection<AgeNexus.Application.Queries.RankingEntry>> Boards { get; } = [];

    protected override async Task OnInitializedAsync()
    {
        var dashboard = await RankingQueries.GetDashboardAsync();
        Boards["Geral competitivo"] = dashboard.GeneralCompetitive;
        Boards["Carreira"] = dashboard.Career;
        Boards["Domínio contra IA"] = dashboard.Pve;
        Boards["Equipes fixas"] = dashboard.TeamLineup;
        Boards["Clãs"] = dashboard.ClanCompetitive;
    }

    private static string GetDescription(string board) => board switch
    {
        "Geral competitivo" => "PvP puro e híbrido com peso reduzido",
        "Carreira" => "Progressão histórica, incluindo 35% do PvE",
        "Domínio contra IA" => "Somente partidas verificadas ou auditadas",
        "Equipes fixas" => "Duplas, trios e quartetos pela formação exata",
        _ => "Prestígio competitivo dos clãs"
    };
}
