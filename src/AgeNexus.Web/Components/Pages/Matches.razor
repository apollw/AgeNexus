@page "/partidas"
@inject AgeNexus.Application.Queries.IMatchHistoryQueryService History

<PageTitle>Partidas · Age Nexus</PageTitle>

<section class="page-heading compact-heading">
    <div><span class="eyebrow">Histórico de batalhas</span><h1>Partidas</h1><p>Reveja confrontos, resultados e estatísticas da comunidade.</p></div>
    @if (IsAuthenticated)
    {
        <div class="page-heading-actions">
            <a class="button button-secondary" href="/partidas/drafts/novo">Draft de civilizações</a>
            <a class="button button-primary" href="/partidas/nova"><span>+</span> Nova partida</a>
            @if (IsAdministrator)
            {
                <a class="button button-secondary" href="/partidas?revisao=pendente">Revisões pendentes</a>
            }
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(DeleteMessage))
{
    <div class="form-alert @(DeleteSucceeded ? "form-alert-success" : "form-alert-error")" role="status">@DeleteMessage</div>
}

<form class="panel match-history-filters" method="get" action="/partidas">
    <label>
        <span>Jogador 1</span>
        <select name="jogador">
            <option value="">Todos os jogadores</option>
            @foreach (var player in Players)
            {
                if (PlayerId == player.Id)
                {
                    <option value="@player.Id" selected>@player.Name</option>
                }
                else
                {
                    <option value="@player.Id">@player.Name</option>
                }
            }
        </select>
    </label>
    <label>
        <span>Adversário</span>
        <select name="adversario">
            <option value="">Qualquer adversário</option>
            @foreach (var player in Players.Where(player => player.Id != PlayerId))
            {
                if (OpponentPlayerId == player.Id)
                {
                    <option value="@player.Id" selected>@player.Name</option>
                }
                else
                {
                    <option value="@player.Id">@player.Name</option>
                }
            }
        </select>
    </label>
    <label>
        <span>Mapa</span>
        <select name="mapa">
            <option value="">Todos os mapas</option>
            @foreach (var map in Maps)
            {
                if (MapDefinitionId == map.Id)
                {
                    <option value="@map.Id" selected>@map.Name</option>
                }
                else
                {
                    <option value="@map.Id">@map.Name</option>
                }
            }
        </select>
    </label>
    <label>
        <span>Tipo de partida</span>
        <select name="tipo">
            <option value="">Todos os tipos</option>
            @foreach (var mode in Enum.GetValues<AgeNexus.Domain.Matches.MatchGameMode>())
            {
                if (SelectedGameMode == mode)
                {
                    <option value="@mode" selected>@GameModeLabel(mode)</option>
                }
                else
                {
                    <option value="@mode">@GameModeLabel(mode)</option>
                }
            }
        </select>
    </label>
    <label><span>De</span><input type="date" name="inicio" value="@FromDate?.ToString("yyyy-MM-dd")" /></label>
    <label><span>Até</span><input type="date" name="fim" value="@ToDate?.ToString("yyyy-MM-dd")" /></label>
    <button class="button button-primary" type="submit">Filtrar</button>
    @if (HasFilters)
    {
        <a class="button button-secondary" href="/partidas">Limpar</a>
    }
</form>

<section class="match-history" aria-label="Histórico de partidas">
    @if (MatchPage.Items.Count == 0)
    {
        <div class="panel panel-empty page-empty">
            <span class="empty-icon">⚔</span><strong>Nenhuma partida encontrada</strong>
            <p>@(HasFilters ? "Tente alterar os filtros para ampliar a busca." : "Registre a primeira batalha para iniciar o histórico.")</p>
        </div>
    }
    else
    {
        <div class="match-history-summary"><strong>@MatchPage.TotalItems partida(s)</strong><span>Página @MatchPage.Page de @MatchPage.TotalPages</span></div>

        @foreach (var match in MatchPage.Items)
        {
            <article class="panel match-history-card">
                <a class="match-history-main" href="/partidas/@match.MatchId" aria-label="Ver detalhes desta partida">
                    <header>
                        <div><span class="status-badge @StatusClass(match.Status)">@StatusLabel(match.Status)</span><span class="match-category">@CategoryLabel(match.Type, match.Category)</span></div>
                        <time datetime="@match.PlayedAtUtc.ToString("O")">@match.PlayedAtUtc.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</time>
                    </header>
                    <div class="match-history-versus">
                        @foreach (var team in match.Teams)
                        {
                            <div class="match-team-card result-@ResultClass(team.Result)">
                                <span class="match-result-mark" aria-hidden="true">@ResultMark(team.Result)</span>
                                <div>
                                    <small>@ResultLabel(team.Result)</small>
                                    <div class="match-participant-list">
                                        @foreach (var participant in team.Participants)
                                        {
                                            <span class="match-participant-civilization">
                                                @if (!string.IsNullOrWhiteSpace(participant.FactionImageUrl))
                                                {
                                                    <img src="@participant.FactionImageUrl" alt="" loading="lazy" />
                                                }
                                                <span><strong>@participant.DisplayName</strong><small>@(participant.FactionName ?? "Civilização não informada")</small></span>
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <footer><span>@match.Format · @GameModeLabel(match.GameMode) · @(match.MapName ?? "Mapa não informado")</span><b>Ver estatísticas <span>→</span></b></footer>
                </a>

                @if (IsAuthenticated || !string.IsNullOrWhiteSpace(match.YouTubeVideoUrl) || match.ScreenshotCount > 0 || match.HasReplay)
                {
                    <div class="match-history-actions">
                        @if (IsAuthenticated)
                        {
                            <a class="table-action" href="/partidas/@match.MatchId/desempenho">@StatisticsActionLabel(match)</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(match.YouTubeVideoUrl))
                        {
                            <a class="table-action table-action-media" href="@match.YouTubeVideoUrl" target="_blank" rel="noopener noreferrer">▶ YouTube</a>
                        }
                        @if (match.ScreenshotCount > 0 || match.HasReplay)
                        {
                            <a class="table-action table-action-media" href="/partidas/@match.MatchId/evidencias">▧ Evidências</a>
                        }
                        @if (IsAdministrator)
                        {
                            <a class="table-action" href="/partidas/@match.MatchId/editar">Editar partida</a>
                            <form method="post" action="/matches/delete" class="match-delete-form" onsubmit="return confirm('Excluir definitivamente esta partida?');">
                                <AntiforgeryToken /><input type="hidden" name="matchId" value="@match.MatchId" />
                                <button class="table-action-button table-action-danger" type="submit">Excluir</button>
                            </form>
                        }
                    </div>
                }
            </article>
        }

        @if (MatchPage.TotalPages > 1)
        {
            <PaginationNav CurrentPage="@MatchPage.Page" TotalItems="@MatchPage.TotalItems" PageSize="@MatchPage.PageSize"
                           BasePath="/partidas" AdditionalQuery="@FilterQuery()" />
        }
    }
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    [SupplyParameterFromQuery(Name = "exclusao")] public string? DeleteStatus { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] public int Page { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "jogador")] public Guid? PlayerId { get; set; }
    [SupplyParameterFromQuery(Name = "adversario")] public Guid? OpponentPlayerId { get; set; }
    [SupplyParameterFromQuery(Name = "mapa")] public Guid? MapDefinitionId { get; set; }
    [SupplyParameterFromQuery(Name = "tipo")] public string? GameModeFilter { get; set; }
    [SupplyParameterFromQuery(Name = "inicio")] public DateOnly? FromDate { get; set; }
    [SupplyParameterFromQuery(Name = "fim")] public DateOnly? ToDate { get; set; }
    [SupplyParameterFromQuery(Name = "revisao")] public string? ReviewFilter { get; set; }

    private AgeNexus.Application.Queries.PagedMatchHistory MatchPage { get; set; } = new([], 1, 10, 0);
    private IReadOnlyCollection<AgeNexus.Application.Queries.CatalogOption> Players { get; set; } = [];
    private IReadOnlyCollection<AgeNexus.Application.Queries.CatalogOption> Maps { get; set; } = [];
    private bool IsAdministrator { get; set; }
    private bool IsAuthenticated { get; set; }
    private Guid? CurrentApplicationUserId { get; set; }
    private AgeNexus.Domain.Matches.MatchGameMode? SelectedGameMode =>
        Enum.TryParse<AgeNexus.Domain.Matches.MatchGameMode>(GameModeFilter, ignoreCase: true, out var mode) &&
        Enum.IsDefined(mode)
            ? mode
            : null;
    private bool PendingReviewOnly => IsAdministrator && ReviewFilter == "pendente";
    private bool HasFilters => PlayerId.HasValue || OpponentPlayerId.HasValue || MapDefinitionId.HasValue ||
        SelectedGameMode.HasValue || FromDate.HasValue || ToDate.HasValue || PendingReviewOnly;
    private bool DeleteSucceeded => DeleteStatus == "ok";
    private string? DeleteMessage => DeleteStatus switch
    {
        "ok" => "Partida excluída.",
        "MatchDeletionNotAuthorized" => "Sua conta não possui permissão para excluir esta partida.",
        "MatchNotFound" => "A partida já não existe.",
        "invalid" => "A partida informada é inválida.",
        "profile" => "Não foi possível identificar seu perfil.",
        null => null,
        _ => "Não foi possível excluir a partida."
    };

    protected override async Task OnParametersSetAsync()
    {
        var authentication = await AuthenticationStateTask;
        IsAuthenticated = authentication.User.Identity?.IsAuthenticated == true;
        IsAdministrator = authentication.User.IsInRole(AgeNexus.Infrastructure.Identity.AccountService.AdministratorRole);
        CurrentApplicationUserId = Guid.TryParse(
            authentication.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out var applicationUserId)
                ? applicationUserId
                : null;
        Players = await History.GetPlayerOptionsAsync();
        Maps = await History.GetMapOptionsAsync();
        MatchPage = await History.GetPageAsync(new(
            Page,
            10,
            FromDate,
            ToDate,
            PlayerId,
            PendingReviewOnly,
            OpponentPlayerId,
            MapDefinitionId,
            SelectedGameMode));
    }

    private string StatisticsActionLabel(AgeNexus.Application.Queries.MatchSummary match)
    {
        if (IsAdministrator)
        {
            return match.StatisticsStatus == AgeNexus.Domain.MatchPerformance.MatchStatisticsStatus.Submitted
                ? "Revisar estatísticas"
                : "Gerenciar estatísticas";
        }

        return match.StatisticsStatus switch
        {
            null => "Enviar estatísticas",
            AgeNexus.Domain.MatchPerformance.MatchStatisticsStatus.Draft
                when CurrentApplicationUserId.HasValue &&
                     (match.StatisticsSubmittedByApplicationUserId == CurrentApplicationUserId ||
                      match.CreatedByApplicationUserId == CurrentApplicationUserId) => "Continuar envio",
            AgeNexus.Domain.MatchPerformance.MatchStatisticsStatus.Submitted
                when CurrentApplicationUserId.HasValue &&
                     (match.StatisticsSubmittedByApplicationUserId == CurrentApplicationUserId ||
                      match.CreatedByApplicationUserId == CurrentApplicationUserId) => "Aguardando aprovação",
            AgeNexus.Domain.MatchPerformance.MatchStatisticsStatus.Confirmed or
                AgeNexus.Domain.MatchPerformance.MatchStatisticsStatus.Awarded => "Ver estatísticas",
            _ => "Ver situação do envio"
        };
    }

    private string FilterQuery()
    {
        var parts = new List<string>();
        if (PlayerId.HasValue) parts.Add($"jogador={PlayerId.Value}");
        if (OpponentPlayerId.HasValue) parts.Add($"adversario={OpponentPlayerId.Value}");
        if (MapDefinitionId.HasValue) parts.Add($"mapa={MapDefinitionId.Value}");
        if (SelectedGameMode.HasValue) parts.Add($"tipo={SelectedGameMode.Value}");
        if (FromDate.HasValue) parts.Add($"inicio={FromDate.Value:yyyy-MM-dd}");
        if (ToDate.HasValue) parts.Add($"fim={ToDate.Value:yyyy-MM-dd}");
        if (PendingReviewOnly) parts.Add("revisao=pendente");
        return string.Join("&", parts);
    }

    private static string GameModeLabel(AgeNexus.Domain.Matches.MatchGameMode value) => value switch
    {
        AgeNexus.Domain.Matches.MatchGameMode.Standard => "Padrão",
        AgeNexus.Domain.Matches.MatchGameMode.Conquest => "Conquista",
        AgeNexus.Domain.Matches.MatchGameMode.Regicide => "Regicídio",
        AgeNexus.Domain.Matches.MatchGameMode.KingOfTheHill => "Rei da Colina",
        AgeNexus.Domain.Matches.MatchGameMode.WonderRace => "Corrida das Maravilhas",
        AgeNexus.Domain.Matches.MatchGameMode.DefendTheWonder => "Defender a Maravilha",
        AgeNexus.Domain.Matches.MatchGameMode.CaptureTheRelic => "Capturar a Relíquia",
        AgeNexus.Domain.Matches.MatchGameMode.SuddenDeath => "Morte Súbita",
        AgeNexus.Domain.Matches.MatchGameMode.DeathMatch => "Combate Mortal",
        AgeNexus.Domain.Matches.MatchGameMode.EmpireWars => "Guerras de Impérios",
        AgeNexus.Domain.Matches.MatchGameMode.BattleRoyale => "Battle Royale",
        _ => "Outro"
    };

    private static string CategoryLabel(
        AgeNexus.Domain.Matches.MatchType type,
        AgeNexus.Domain.Matches.MatchScoringCategory value) => type == AgeNexus.Domain.Matches.MatchType.FreeForAll
        ? "Todos contra todos"
        : value switch
    {
        AgeNexus.Domain.Matches.MatchScoringCategory.PurePvp => "PvP competitivo",
        AgeNexus.Domain.Matches.MatchScoringCategory.HybridPvp => "PvP com IA",
        AgeNexus.Domain.Matches.MatchScoringCategory.PurePve => "Humanos contra IA",
        _ => "Partida não ranqueada"
    };

    private static string StatusLabel(AgeNexus.Domain.Matches.MatchStatus value) => value switch
    {
        AgeNexus.Domain.Matches.MatchStatus.Validated => "Validada",
        AgeNexus.Domain.Matches.MatchStatus.Confirmed => "Confirmada",
        AgeNexus.Domain.Matches.MatchStatus.AwaitingConfirmation => "Aguardando confirmação",
        AgeNexus.Domain.Matches.MatchStatus.Disputed => "Em análise",
        AgeNexus.Domain.Matches.MatchStatus.Voided => "Anulada",
        AgeNexus.Domain.Matches.MatchStatus.Submitted => "Registrada",
        _ => "Rascunho"
    };

    private static string StatusClass(AgeNexus.Domain.Matches.MatchStatus value) => value switch
    {
        AgeNexus.Domain.Matches.MatchStatus.Validated => "validated",
        AgeNexus.Domain.Matches.MatchStatus.Confirmed => "confirmed",
        _ => "pending"
    };

    private static string ResultLabel(AgeNexus.Domain.Matches.TeamResult value) => value switch
    {
        AgeNexus.Domain.Matches.TeamResult.Victory => "Vitória",
        AgeNexus.Domain.Matches.TeamResult.Defeat => "Derrota",
        AgeNexus.Domain.Matches.TeamResult.Draw => "Empate",
        _ => "Resultado pendente"
    };

    private static string ResultMark(AgeNexus.Domain.Matches.TeamResult value) => value switch
    {
        AgeNexus.Domain.Matches.TeamResult.Victory => "◆",
        AgeNexus.Domain.Matches.TeamResult.Defeat => "◇",
        AgeNexus.Domain.Matches.TeamResult.Draw => "●",
        _ => "○"
    };

    private static string ResultClass(AgeNexus.Domain.Matches.TeamResult value) => value.ToString().ToLowerInvariant();
}
