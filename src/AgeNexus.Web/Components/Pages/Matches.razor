@page "/partidas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AgeNexus.Application.Queries.IMatchHistoryQueryService History
@inject AgeNexus.Application.Matches.IMatchWorkflowService Workflow
@inject AgeNexus.Infrastructure.Identity.AccountService Accounts

<PageTitle>Partidas · Age Nexus</PageTitle>

<section class="page-heading compact-heading">
    <div><span class="eyebrow">Histórico de batalhas</span><h1>Partidas</h1><p>Resultados, confirmações e evidências da comunidade.</p></div>
    <a class="button button-primary" href="/partidas/nova"><span>+</span> Nova partida</a>
</section>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="form-alert @(HasError ? "form-alert-error" : "form-alert-success")" role="status">@Message</div>
}

<section class="panel table-panel">
    <div class="data-table match-table">
        <div class="table-head"><span>Confronto</span><span>Formato</span><span>Categoria</span><span>Status</span><span>Data</span><span>Ações</span></div>
        @if (RecentMatches.Count == 0)
        {
            <div class="panel-empty table-empty">
                <span class="empty-icon">⚔</span><strong>Nenhuma partida encontrada</strong>
                <p>Registre a primeira batalha para iniciar o histórico.</p>
            </div>
        }
        else
        {
            @foreach (var match in RecentMatches)
            {
                <div class="table-row">
                    <span><a href="/partidas/@match.MatchId/desempenho">@string.Join(" × ", match.Teams)</a></span>
                    <span>@match.Format</span>
                    <span>@match.Category</span>
                    <span>@match.Status</span>
                    <span>@match.PlayedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    <span class="match-actions">
                        <a class="table-action" href="/partidas/@match.MatchId/desempenho">Preencher estatísticas →</a>
                        @if (CurrentProfile?.Id == match.CreatedByPlayerProfileId)
                        {
                            @if (PendingDeleteId == match.MatchId)
                            {
                                <span class="match-delete-confirm">Excluir definitivamente?</span>
                                <button class="table-action-button table-action-danger" type="button"
                                        @onclick="() => DeleteAsync(match.MatchId)" disabled="@(BusyMatchId.HasValue)">Sim</button>
                                <button class="table-action-button" type="button" @onclick="CancelDelete"
                                        disabled="@(BusyMatchId.HasValue)">Não</button>
                            }
                            else
                            {
                                <button class="table-action-button table-action-danger" type="button"
                                        @onclick="() => RequestDelete(match.MatchId)">Excluir</button>
                            }
                        }
                    </span>
                </div>
            }
        }
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private IReadOnlyCollection<AgeNexus.Application.Queries.MatchSummary> RecentMatches { get; set; } = [];
    private AgeNexus.Infrastructure.Identity.PublicProfile? CurrentProfile { get; set; }
    private Guid? PendingDeleteId { get; set; }
    private Guid? BusyMatchId { get; set; }
    private string? Message { get; set; }
    private bool HasError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authentication = await AuthenticationStateTask;
        CurrentProfile = await Accounts.GetProfileAsync(authentication.User, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task ReloadAsync() => RecentMatches = await History.GetRecentAsync();

    private void RequestDelete(Guid matchId)
    {
        PendingDeleteId = matchId;
        Message = null;
    }

    private void CancelDelete() => PendingDeleteId = null;

    private async Task DeleteAsync(Guid matchId)
    {
        if (CurrentProfile is null)
        {
            return;
        }

        BusyMatchId = matchId;
        Message = null;
        var result = await Workflow.DeleteAsync(matchId, CurrentProfile.Id);
        HasError = !result.Succeeded;
        Message = result.Succeeded
            ? "Partida excluída."
            : result.ErrorCode switch
            {
                "MatchCannotBeDeleted" => "Partidas já validadas não podem ser excluídas; elas devem ser anuladas para preservar o histórico.",
                "MatchDeletionNotAuthorized" => "Somente quem registrou a partida pode excluí-la.",
                "MatchNotFound" => "A partida já não existe.",
                _ => "Não foi possível excluir a partida."
            };
        PendingDeleteId = null;
        BusyMatchId = null;
        if (result.Succeeded)
        {
            await ReloadAsync();
        }
    }
}
