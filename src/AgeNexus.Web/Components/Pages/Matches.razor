@page "/partidas"
@inject AgeNexus.Application.Queries.IMatchHistoryQueryService History

<PageTitle>Partidas · Age Nexus</PageTitle>

<section class="page-heading compact-heading">
    <div><span class="eyebrow">Histórico de batalhas</span><h1>Partidas</h1><p>Resultados, confirmações e evidências da comunidade.</p></div>
    <a class="button button-primary" href="/partidas/nova"><span>+</span> Nova partida</a>
</section>

@if (!string.IsNullOrWhiteSpace(DeleteMessage))
{
    <div class="form-alert @(DeleteSucceeded ? "form-alert-success" : "form-alert-error")" role="status">@DeleteMessage</div>
}

<section class="panel table-panel">
    <div class="data-table match-table">
        <div class="table-head"><span>Confronto</span><span>Formato</span><span>Categoria</span><span>Status</span><span>Data</span><span>Ações</span></div>
        @if (RecentMatches.Count == 0)
        {
            <div class="panel-empty table-empty">
                <span class="empty-icon">⚔</span><strong>Nenhuma partida encontrada</strong>
                <p>Registre a primeira batalha para iniciar o histórico.</p>
            </div>
        }
        else
        {
            @foreach (var match in RecentMatches)
            {
                <div class="table-row">
                    <span><a href="/partidas/@match.MatchId/desempenho">@string.Join(" × ", match.Teams)</a></span>
                    <span>@match.Format</span>
                    <span>@match.Category</span>
                    <span>@match.Status</span>
                    <span>@match.PlayedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    <div class="match-actions">
                        <a class="table-action" href="/partidas/@match.MatchId/desempenho">Preencher estatísticas →</a>
                        @if (CurrentApplicationUserId.HasValue &&
                             CurrentApplicationUserId == match.CreatedByApplicationUserId)
                        {
                            <form method="post" action="/matches/delete" class="match-delete-form"
                                  onsubmit="return confirm('Excluir definitivamente esta partida?');">
                                <AntiforgeryToken />
                                <input type="hidden" name="matchId" value="@match.MatchId" />
                                <button class="table-action-button table-action-danger" type="submit">Excluir</button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "exclusao")]
    private string? DeleteStatus { get; set; }

    private IReadOnlyCollection<AgeNexus.Application.Queries.MatchSummary> RecentMatches { get; set; } = [];
    private Guid? CurrentApplicationUserId { get; set; }
    private bool DeleteSucceeded => DeleteStatus == "ok";
    private string? DeleteMessage => DeleteStatus switch
    {
        "ok" => "Partida excluída.",
        "MatchCannotBeDeleted" => "Partidas já validadas não podem ser excluídas; elas devem ser anuladas para preservar o histórico.",
        "MatchDeletionNotAuthorized" => "Somente quem registrou a partida pode excluí-la.",
        "MatchNotFound" => "A partida já não existe.",
        "invalid" => "A partida informada é inválida.",
        "profile" => "Não foi possível identificar seu perfil.",
        null => null,
        _ => "Não foi possível excluir a partida."
    };

    protected override async Task OnInitializedAsync()
    {
        var authentication = await AuthenticationStateTask;
        var userId = authentication.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        CurrentApplicationUserId = Guid.TryParse(userId, out var parsedUserId) ? parsedUserId : null;
        RecentMatches = await History.GetRecentAsync();
    }
}
