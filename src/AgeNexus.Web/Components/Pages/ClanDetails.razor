@page "/clas/{ClanId:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@inject AgeNexus.Application.Queries.IClanQueryService ClanQueries
@inject AgeNexus.Application.Queries.IClanService ClanCommands
@inject AgeNexus.Application.Queries.IPlayerDirectoryQueryService Players
@inject AgeNexus.Application.Queries.IRankingQueryService Rankings
@inject AgeNexus.Infrastructure.Identity.AccountService Accounts
@inject NavigationManager Navigation

<PageTitle>@(Clan?.Name ?? "Clã") · Age Nexus</PageTitle>
<LoadingOverlay Visible="@(Loading || Saving)" Message="@(Saving ? "Salvando clã..." : "Carregando clã...")" />

@if (!Loading && Clan is null)
{
    <section class="panel panel-empty page-empty"><strong>Clã não encontrado.</strong><a class="button button-primary" href="/clas">Voltar aos clãs</a></section>
}
else if (Clan is not null)
{
    <a class="public-profile-back" href="/clas">← Todos os clãs</a>
    <section class="panel clan-hero">
        <div class="clan-emblem">@if (!string.IsNullOrWhiteSpace(Clan.ImageUrl)) { <img src="@Clan.ImageUrl" alt="Emblema de @Clan.Name" /> } else { <strong>@Clan.Tag</strong> }</div>
        <div><span class="eyebrow">[@Clan.Tag] · @(Clan.IsRecruiting ? "Recrutando" : "Elenco fechado")</span><h1>@Clan.Name</h1><p>@(Clan.Motto ?? "Unidos pela estratégia e pela comunidade.")</p></div>
        <a class="button button-primary" href="/partidas/nova?cla1=@Clan.ClanId">Registrar confronto</a>
    </section>

    @if (!string.IsNullOrWhiteSpace(Message)) { <div class="form-alert @(Failed ? "form-alert-error" : "form-alert-success")">@Message</div> }
    <nav class="clan-tabs" aria-label="Seções do clã">
        @foreach (var tab in new[] { "visao", "membros", "partidas", "ranking" })
        { <button class="@(ActiveTab == tab ? "active" : null)" @onclick="() => ActiveTab = tab">@TabLabel(tab)</button> }
    </nav>

    @if (ActiveTab == "visao")
    {
        <section class="clan-detail-grid">
            <article class="panel clan-about"><span class="eyebrow">Sobre o clã</span><p>@(Clan.Description ?? "O clã ainda não adicionou uma apresentação.")</p><strong>@Clan.ActiveMembers integrante(s)</strong></article>
            @if (CanManage)
            {
                <article class="panel profile-form-card"><h2>Personalizar clã</h2>
                    <div class="account-form">
                        <label class="form-field"><span>Nome</span><input @bind="EditName" maxlength="100" /></label>
                        <label class="form-field"><span>Tag</span><input @bind="EditTag" maxlength="8" /></label>
                        <label class="form-field"><span>Lema</span><input @bind="EditMotto" maxlength="120" /></label>
                        <label class="form-field"><span>Descrição</span><textarea @bind="EditDescription" maxlength="500" rows="4"></textarea></label>
                        <label class="account-delete-check"><input type="checkbox" @bind="EditRecruiting" /><span>Clã aberto a novos integrantes</span></label>
                        <button class="button button-primary" @onclick="SaveClanAsync">Salvar identidade</button>
                        <label class="button button-secondary clan-image-upload">Enviar emblema<InputFile OnChange="UploadImageAsync" accept=".jpg,.jpeg,.png,.webp" /></label>
                        <button class="table-action-button table-action-danger" type="button" @onclick="DeleteClanAsync">Excluir clã</button>
                    </div>
                </article>
            }
        </section>
    }
    else if (ActiveTab == "membros")
    {
        <section class="panel clan-members-panel">
            @foreach (var member in Clan.Members.OrderBy(x => x.Role))
            {
                <article class="clan-member-card"><PlayerAvatar DisplayName="@member.DisplayName" Url="@member.AvatarUrl" Size="directory" /><div><a href="/jogadores/@member.PlayerProfileId"><strong>@member.DisplayName</strong></a><span>@RoleLabel(member.Role)@(string.IsNullOrWhiteSpace(member.Title) ? "" : $" · {member.Title}")</span><p>@member.Note</p></div>
                    @if (CanManage && member.PlayerProfileId != Clan.CreatedByPlayerProfileId)
                    { <div class="clan-member-actions"><button @onclick="() => ChangeRoleAsync(member, member.Role == AgeNexus.Domain.Clans.ClanRole.Officer ? AgeNexus.Domain.Clans.ClanRole.Member : AgeNexus.Domain.Clans.ClanRole.Officer)">@(member.Role == AgeNexus.Domain.Clans.ClanRole.Officer ? "Tornar membro" : "Tornar oficial")</button><button class="danger" @onclick="() => RemoveMemberAsync(member)">Remover</button></div> }
                </article>
            }
            @if (IsMember)
            { <div class="clan-self-edit"><h3>Minha apresentação no clã</h3><label class="form-field"><span>Função ou título</span><input @bind="MemberTitle" maxlength="80" /></label><label class="form-field"><span>Apresentação</span><textarea @bind="MemberNote" maxlength="300"></textarea></label><button class="button button-secondary" @onclick="SaveOwnMembershipAsync">Salvar minha apresentação</button></div> }
            @if (CanManage)
            { <div class="clan-add-member"><label class="form-field"><span>Adicionar jogador</span><select @bind="NewMemberId"><option value="">Selecione</option>@foreach (var player in AvailablePlayers) { <option value="@player.PlayerId">@player.DisplayName</option> }</select></label><button class="button button-primary" @onclick="AddMemberAsync" disabled="@(!NewMemberId.HasValue)">Adicionar</button></div> }
        </section>
    }
    else if (ActiveTab == "partidas")
    {
        <section class="panel clan-action-panel"><span class="eyebrow">Confrontos oficiais</span><h2>Clã contra clã</h2><p>Abra o registro com este elenco já selecionado e escolha o clã adversário na segunda equipe.</p><a class="button button-primary" href="/partidas/nova?cla1=@Clan.ClanId">Registrar partida do clã</a></section>
    }
    else
    {
        <section class="panel clan-action-panel"><span class="eyebrow">Ranking competitivo</span><h2>@(ClanRanking is null ? "Ainda sem classificação" : $"#{ClanRanking.Position} · {ClanRanking.Score:0} pontos")</h2><p>@(ClanRanking is null ? "O ranking de clãs já existe e será preenchido quando houver eventos competitivos de clã validados." : $"{ClanRanking.ValidatedMatches} partida(s) validadas.")</p><a class="button button-secondary" href="/rankings">Ver ranking completo</a></section>
    }
}

@code {
    [Parameter] public Guid ClanId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private AgeNexus.Application.Queries.ClanSummary? Clan;
    private AgeNexus.Infrastructure.Identity.PublicProfile? Profile;
    private AgeNexus.Application.Queries.RankingEntry? ClanRanking;
    private IReadOnlyCollection<AgeNexus.Application.Queries.PlayerSummary> PlayerItems = [];
    private ClaimsPrincipal Principal = new(new ClaimsIdentity());
    private string ActiveTab="visao", EditName="", EditTag="", EditDescription="", EditMotto="", MemberTitle="", MemberNote="";
    private bool EditRecruiting, Loading=true, Saving, IsAdmin, Failed; private string? Message; private Guid? NewMemberId;
    private bool CanManage => Clan is not null && (IsAdmin || Profile?.Id == Clan.CreatedByPlayerProfileId);
    private bool IsMember => Clan?.Members.Any(x => x.PlayerProfileId == Profile?.Id) == true;
    private IEnumerable<AgeNexus.Application.Queries.PlayerSummary> AvailablePlayers => PlayerItems.Where(x => Clan?.Members.All(m => m.PlayerProfileId != x.PlayerId) == true);
    protected override async Task OnInitializedAsync() { var auth=await AuthenticationStateTask; Principal=auth.User; Profile=await Accounts.GetProfileAsync(auth.User,CancellationToken.None); IsAdmin=await Accounts.IsAdministratorAsync(auth.User); await ReloadAsync(); Loading=false; }
    private async Task ReloadAsync() { Clan=(await ClanQueries.GetAsync()).SingleOrDefault(x=>x.ClanId==ClanId); PlayerItems=await Players.GetAsync(500); ClanRanking=(await Rankings.GetAsync(AgeNexus.Application.Queries.RankingBoard.ClanCompetitive,limit:500)).SingleOrDefault(x=>x.BeneficiaryId==ClanId); if(Clan is not null){EditName=Clan.Name;EditTag=Clan.Tag;EditDescription=Clan.Description??"";EditMotto=Clan.Motto??"";EditRecruiting=Clan.IsRecruiting;var me=Clan.Members.SingleOrDefault(x=>x.PlayerProfileId==Profile?.Id);MemberTitle=me?.Title??"";MemberNote=me?.Note??"";} }
    private async Task RunAsync(Func<Task<AgeNexus.Application.Queries.ClanOperationResult>> action,string success){Saving=true;var r=await action();Failed=!r.Succeeded;Message=r.Succeeded?success:ErrorText(r.ErrorCode);if(r.Succeeded)await ReloadAsync();Saving=false;}
    private Task SaveClanAsync()=>RunAsync(()=>ClanCommands.UpdateAsync(Principal,ClanId,EditName,EditTag,EditDescription,EditMotto,EditRecruiting),"Clã atualizado.");
    private async Task UploadImageAsync(InputFileChangeEventArgs e){try{await using var s=e.File.OpenReadStream(2*1024*1024);using var m=new MemoryStream();await s.CopyToAsync(m);await RunAsync(()=>ClanCommands.UploadImageAsync(Principal,ClanId,e.File.Name,m.ToArray()),"Emblema atualizado.");}catch(IOException){Failed=true;Message="A imagem deve ter até 2 MB.";}}
    private Task AddMemberAsync()=>RunAsync(()=>ClanCommands.AddMemberAsync(Principal,ClanId,NewMemberId!.Value),"Integrante adicionado.");
    private Task RemoveMemberAsync(AgeNexus.Application.Queries.ClanMemberSummary m)=>RunAsync(()=>ClanCommands.RemoveMemberAsync(Principal,ClanId,m.PlayerProfileId),"Integrante removido.");
    private Task ChangeRoleAsync(AgeNexus.Application.Queries.ClanMemberSummary m,AgeNexus.Domain.Clans.ClanRole r)=>RunAsync(()=>ClanCommands.ChangeRoleAsync(Principal,ClanId,m.PlayerProfileId,r),"Permissão atualizada.");
    private Task SaveOwnMembershipAsync()=>RunAsync(()=>ClanCommands.UpdateOwnMembershipAsync(Principal,ClanId,MemberTitle,MemberNote),"Sua apresentação foi atualizada.");
    private async Task DeleteClanAsync(){await RunAsync(()=>ClanCommands.DeleteAsync(Principal,ClanId),"Clã excluído.");if(!Failed)Navigation.NavigateTo("/clas",true);}
    private static string TabLabel(string t)=>t switch{"visao"=>"Visão geral","membros"=>"Membros","partidas"=>"Partidas","ranking"=>"Ranking",_=>t};
    private static string RoleLabel(AgeNexus.Domain.Clans.ClanRole r)=>r switch{AgeNexus.Domain.Clans.ClanRole.Leader=>"Líder",AgeNexus.Domain.Clans.ClanRole.Officer=>"Oficial",_=>"Membro"};
    private static string ErrorText(string? e)=>e switch{"NotAuthorized"=>"Você não possui permissão.","DuplicateClan"=>"Nome ou tag já estão em uso.","MemberAlreadyInClan"=>"Esse jogador já pertence a um clã.","ClanFull"=>"O clã atingiu oito integrantes.","InvalidImage"=>"Use JPEG, PNG ou WebP com até 2 MB.","StorageUnavailable"=>"O envio de imagens está indisponível.",_=>"Não foi possível concluir a operação."};
}
