@page "/clas"
@inject AgeNexus.Application.Queries.IClanQueryService ClanQueries

<PageTitle>Clãs · Age Nexus</PageTitle>

<section class="page-heading compact-heading">
    <div><span class="eyebrow">Comunidade</span><h1>Clãs</h1><p>Reúna jogadores, acompanhe os membros e construa o prestígio do grupo.</p></div>
</section>

<section class="panel table-panel">
    @if (ClanItems.Count == 0)
    {
        <div class="panel-empty page-empty"><strong>Nenhum clã criado</strong><p>Os primeiros clãs aparecerão aqui.</p></div>
    }
    else
    {
        <div class="data-table clan-table mobile-card-table">
            <div class="table-head"><span>Tag</span><span>Clã</span><span>Membros</span></div>
            @foreach (var clan in VisibleClans)
            {
                <div class="table-row">
                    <span data-label="Tag">[@clan.Tag]</span>
                    <span data-label="Clã">@clan.Name</span>
                    <span data-label="Membros" data-mobile-wide="true">@clan.ActiveMembers</span>
                </div>
            }
        </div>
    }
</section>
<PaginationNav CurrentPage="@CurrentPage" TotalItems="@ClanItems.Count" PageSize="@PageSize" BasePath="/clas" />

@code {
    private const int PageSize = 15;
    [SupplyParameterFromQuery(Name = "pagina")] private int Page { get; set; } = 1;
    private IReadOnlyCollection<AgeNexus.Application.Queries.ClanSummary> ClanItems { get; set; } = [];
    private int CurrentPage => Math.Clamp(Page, 1, Math.Max(1, (int)Math.Ceiling(ClanItems.Count / (double)PageSize)));
    private IEnumerable<AgeNexus.Application.Queries.ClanSummary> VisibleClans =>
        ClanItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    protected override async Task OnParametersSetAsync() => ClanItems = await ClanQueries.GetAsync();
}
