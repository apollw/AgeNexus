@page "/partidas/drafts/{ShareCode}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using Microsoft.JSInterop
@inject AgeNexus.Application.Drafts.ICivilizationDraftService Drafts
@inject AgeNexus.Application.Drafts.ICivilizationDraftNotifier Notifier
@inject AgeNexus.Infrastructure.Identity.AccountService Accounts
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript
@inject ILogger<CivilizationDraftRoom> Logger

<PageTitle>Draft de civilizações · Age Nexus</PageTitle>
<LoadingOverlay Visible="@Loading" Message="Atualizando a sala..." />

@if (Draft is null && !Loading)
{
    <section class="panel panel-empty page-empty"><strong>Draft não encontrado</strong><p>Confira o link compartilhado.</p><a class="button button-secondary" href="/partidas">Voltar às partidas</a></section>
}
else if (Draft is not null && Profile is not null)
{
    <section class="page-heading compact-heading draft-room-heading">
        <div><span class="eyebrow">@PhaseLabel(Draft.Phase)</span><h1>@Draft.Title</h1><p>@(Draft.MapName ?? "Mapa a definir") · @ModeLabel(Draft.GameMode) · sala <strong>@Draft.ShareCode</strong></p></div>
        <div class="page-heading-actions"><button class="button button-secondary" @onclick="CopyLinkAsync">@(Copied ? "Link copiado" : "Copiar link")</button>@if (Draft.Phase == AgeNexus.Application.Drafts.CivilizationDraftPhase.Completed) { <button class="button button-primary" @onclick="DownloadImageAsync">Baixar imagem</button> }</div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="form-alert @(OperationFailed ? "form-alert-error" : "form-alert-success")">@Message</div>
    }

    <section class="draft-status-strip" aria-label="Estado do draft">
        <div><span>Etapa atual</span><strong>@PhaseLabel(Draft.Phase)</strong></div>
        <div><span>Vez de</span><strong>@(CurrentRepresentativeName ?? "Aguardando início")</strong></div>
        <div><span>Progresso</span><strong>@Draft.CompletedActions de @Draft.TotalActions ações</strong></div>
        <div><span>Tempo da jogada</span><strong class="draft-timer @(RemainingSeconds <= 10 ? "is-ending" : null)">@(IsActive ? $"{RemainingSeconds}s" : "—")</strong></div>
        <div><span>Civilizações livres</span><strong>@AvailableFactions de @Draft.Pool.Count</strong></div>
    </section>

    <section class="draft-versus-layout" aria-label="Equipes do draft">
        @for (var teamIndex = 0; teamIndex < Draft.Teams.Count; teamIndex++)
        {
            var team = Draft.Teams.ElementAt(teamIndex);
            <article class="panel draft-team-card @(CurrentTeam?.RepresentativePlayerProfileId == team.RepresentativePlayerProfileId ? "is-active" : null)">
                <header><div><span>Equipe @(teamIndex + 1)</span><h2>@team.Name</h2></div><span class="draft-ready-badge @(team.RepresentativeReady ? "ready" : null)">@(team.RepresentativeReady ? "Representante online" : "Aguardando representante")</span></header>
                <div class="draft-representative-line">Representante: <strong>@team.RepresentativeDisplayName</strong></div>
                <div class="draft-team-roster">
                    @foreach (var player in team.Players)
                    {
                        <div class="draft-player-row @(player.PlayerProfileId == team.RepresentativePlayerProfileId ? "is-representative" : null)">
                            <div class="draft-avatar">@if (!string.IsNullOrWhiteSpace(player.AvatarUrl)) { <img src="@player.AvatarUrl" alt="" /> } else { <span>@player.DisplayName[..1].ToUpperInvariant()</span> }</div>
                            <div class="draft-player-copy"><strong>@player.DisplayName</strong><small>@(player.PlayerProfileId == team.RepresentativePlayerProfileId ? "Representante" : "Jogador")</small></div>
                            <div class="draft-player-pick"><small>@(player.PlayerProfileId == team.RepresentativePlayerProfileId ? "Responsável pelas escolhas" : "Integrante da equipe")</small></div>
                        </div>
                    }
                </div>
                <div class="draft-team-picks">
                    <span>Escolhas da equipe</span>
                    @if (team.Picks.Count == 0) { <small>Nenhuma civilização escolhida</small> }
                    else { <div>@foreach (var pick in team.Picks) { <strong>@pick.FactionName</strong> }</div> }
                </div>
            </article>
            @if (teamIndex == 0) { <div class="draft-versus-mark" aria-hidden="true">VS</div> }
        }
    </section>

    @if (Draft.Phase == AgeNexus.Application.Drafts.CivilizationDraftPhase.Lobby)
    {
        <section class="panel draft-action-panel"><div><span class="eyebrow">Confirmação</span><h2>Os dois representantes devem entrar</h2><p>Somente o representante definido de cada equipe confirma presença e executa as escolhas.</p></div><div class="draft-action-buttons">@if (MyTeam is not null) { <button class="button @(MyTeam.RepresentativeReady ? "button-secondary" : "button-primary")" @onclick="ToggleReadyAsync">@(MyTeam.RepresentativeReady ? "Cancelar presença" : "Confirmar presença")</button> }@if (IsOrganizer) { <button class="button button-primary" @onclick="StartAsync">Sortear e iniciar draft</button> }</div></section>
    }
    else if (Draft.Phase is AgeNexus.Application.Drafts.CivilizationDraftPhase.Bans or AgeNexus.Application.Drafts.CivilizationDraftPhase.Picks)
    {
        <section class="panel draft-action-panel">
            <div><span class="eyebrow">@ActionTitle</span><h2>@ActionInstruction</h2><p>@ActionHelp</p></div>
            <div class="draft-clock" aria-label="Tempo restante"><span>@RemainingSeconds</span><small>segundos</small></div>
        </section>
    }
    else if (Draft.Phase == AgeNexus.Application.Drafts.CivilizationDraftPhase.Completed)
    {
        <section class="draft-finalized-banner" role="status" aria-live="polite"><span aria-hidden="true">✓</span><div><strong>Draft finalizado</strong><p>Todos os bans e picks foram definidos. A composição já pode ser compartilhada.</p></div></section>
    }

    <section class="draft-pool-panel">
        <header class="draft-pool-heading"><div><span class="eyebrow">Pool completa</span><h2>Civilizações</h2><p>A lista é atualizada imediatamente após cada ação.</p></div><div class="draft-pool-legend"><span><i class="available"></i>Disponível</span><span><i class="banned"></i>Banida</span><span><i class="picked"></i>Escolhida</span></div></header>
        <div class="draft-faction-grid" aria-label="Todas as civilizações">
            @foreach (var faction in Draft.Pool)
            {
                <button type="button" class="draft-faction-card @(faction.IsBanned ? "banned" : faction.IsPicked ? "picked" : "available")" disabled="@FactionDisabled(faction)" @onclick="() => SelectFactionAsync(faction.Id)">
                    <span class="draft-civ-mark">@faction.Name[..1]</span><strong>@faction.Name</strong>
                    @if (faction.IsBanned) { <small>Banida@(string.IsNullOrWhiteSpace(faction.BannedByTeamName) ? "" : $" por {faction.BannedByTeamName}")</small> } else if (faction.IsPicked) { <small>Escolhida por @faction.AssignedTeamName</small> } else { <small>Disponível</small> }
                </button>
            }
        </div>
    </section>

    @if (IsActive)
    {
        <aside class="draft-floating-status @(IsMyTurn ? "is-my-turn" : null) @(FloatingStatusCollapsed ? "is-collapsed" : null)" aria-label="Situação atual do draft">
            <header>
                <div>
                    <span>@ActionTitle</span>
                    <strong>@(IsMyTurn ? "Sua vez" : $"Vez de {CurrentTeam?.Name}")</strong>
                </div>
                <button type="button" @onclick="ToggleFloatingStatus" aria-label="@(FloatingStatusCollapsed ? "Expandir aviso do draft" : "Recolher aviso do draft")" title="@(FloatingStatusCollapsed ? "Expandir" : "Recolher")">
                    @(FloatingStatusCollapsed ? "+" : "−")
                </button>
            </header>
            @if (!FloatingStatusCollapsed)
            {
                <div class="draft-floating-body">
                    <p aria-live="polite">@ActionInstruction</p>
                    @if (Draft.LastAction is not null)
                    {
                        <small><strong>@Draft.LastAction.TeamName</strong> @(Draft.LastAction.Kind == AgeNexus.Application.Drafts.CivilizationDraftActionKind.Ban ? "baniu" : "escolheu") @Draft.LastAction.FactionName@(Draft.LastAction.WasAutomatic ? " automaticamente" : "").</small>
                    }
                </div>
            }
            <footer>
                <span>@(Draft.CurrentAction == AgeNexus.Application.Drafts.CivilizationDraftActionKind.Ban ? "Escolha um ban" : "Escolha um pick")</span>
                <strong class="@(RemainingSeconds <= 10 ? "is-ending" : null)">@RemainingSeconds<small>s</small></strong>
            </footer>
        </aside>
    }

    @if (IsOrganizer && Draft.Phase is not AgeNexus.Application.Drafts.CivilizationDraftPhase.Completed and not AgeNexus.Application.Drafts.CivilizationDraftPhase.Cancelled)
    {
        <div class="draft-danger-zone"><button class="table-action-button table-action-danger" @onclick="CancelAsync">Cancelar draft</button></div>
    }

    @if (PendingFaction is not null)
    {
        <div class="draft-confirm-backdrop" role="presentation">
            <section class="draft-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="draft-confirm-title">
                <span class="eyebrow">Confirmação necessária</span>
                <h2 id="draft-confirm-title">Confirmar @((PendingAction == DraftAction.Ban ? "ban" : "pick"))?</h2>
                @if (PendingAction == DraftAction.Ban)
                {
                    <p>Você está prestes a banir <strong>@PendingFaction.Name</strong>. Ela ficará indisponível para as duas equipes.</p>
                }
                else
                {
                    <p>Você está prestes a escolher <strong>@PendingFaction.Name</strong> para <strong>@MyTeam?.Name</strong>. Os jogadores poderão dividir as civilizações entre si.</p>
                }
                <div class="draft-confirm-actions"><button type="button" class="button button-secondary" @onclick="CancelPendingAction">Voltar</button><button type="button" class="button button-primary" @onclick="ConfirmPendingActionAsync">Confirmar @((PendingAction == DraftAction.Ban ? "ban" : "pick"))</button></div>
            </section>
        </div>
    }
}

@code {
    [Parameter] public string ShareCode { get; set; } = "";
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private AgeNexus.Application.Drafts.CivilizationDraftView? Draft;
    private AgeNexus.Infrastructure.Identity.PublicProfile? Profile;
    private Guid? PendingFactionId;
    private DraftAction? PendingAction;
    private readonly CancellationTokenSource ClockCancellation = new();
    private readonly SemaphoreSlim refreshGate = new(1, 1);
    private bool reloadRequested;
    private bool commandInProgress;
    private bool Loading = true, OperationFailed, Copied;
    private bool FloatingStatusCollapsed;
    private string? Message;
    private bool IsOrganizer => Draft?.CreatedByPlayerProfileId == Profile?.Id;
    private bool IsMyTurn => Draft?.CurrentPlayerProfileId == Profile?.Id;
    private AgeNexus.Application.Drafts.CivilizationDraftTeamView? MyTeam => Draft?.Teams.SingleOrDefault(x => x.RepresentativePlayerProfileId == Profile?.Id);
    private AgeNexus.Application.Drafts.CivilizationDraftTeamView? CurrentTeam => Draft?.Teams.SingleOrDefault(x => x.RepresentativePlayerProfileId == Draft.CurrentPlayerProfileId);
    private string? CurrentRepresentativeName => CurrentTeam?.RepresentativeDisplayName;
    private int AvailableFactions => Draft?.Pool.Count(x => !x.IsBanned && !x.IsPicked) ?? 0;
    private AgeNexus.Application.Drafts.CivilizationDraftFactionView? PendingFaction => Draft?.Pool.SingleOrDefault(x => x.Id == PendingFactionId);
    private bool IsActive => Draft?.CurrentAction is not null;
    private int RemainingSeconds => Draft?.TurnDeadlineUtc is { } deadline
        ? Math.Max(0, (int)Math.Ceiling((deadline - DateTimeOffset.UtcNow).TotalSeconds))
        : 0;
    private string ActionTitle => Draft?.CurrentAction == AgeNexus.Application.Drafts.CivilizationDraftActionKind.Ban ? "Ban da rodada" : "Pick da rodada";
    private string ActionInstruction => IsMyTurn
        ? Draft?.CurrentAction == AgeNexus.Application.Drafts.CivilizationDraftActionKind.Ban
            ? "Escolha uma civilização para banir"
            : $"Escolha uma civilização para {MyTeam?.Name}"
        : $"Aguardando {CurrentRepresentativeName}";
    private string ActionHelp => "A sequência de cada rodada é: ban, ban, pick e pick. Se o tempo acabar, o sistema escolherá automaticamente.";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateTask;
        Profile = await Accounts.GetProfileAsync(auth.User, CancellationToken.None);
        Notifier.Changed += DraftChangedAsync;
        await LoadAsync();
        _ = RunClockAsync();
    }
    protected override async Task OnParametersSetAsync() { if (Profile is not null) await LoadAsync(); }
    private async Task LoadAsync(bool showLoading = true)
    {
        // Relógio, notificações e ações do usuário disputam o mesmo DbContext (scoped por circuito).
        // A fila serializa as leituras e agrupa pedidos repetidos, evitando operações concorrentes.
        reloadRequested = true;
        if (commandInProgress) return;
        if (showLoading) Loading = true;
        await refreshGate.WaitAsync();
        try
        {
            while (reloadRequested)
            {
                reloadRequested = false;
                Draft = Profile is null ? null : await Drafts.GetAsync(ShareCode, Profile.Id);
                if (!IsMyTurn || PendingFaction is { IsBanned: true } or { IsPicked: true }) CancelPendingAction();
            }
        }
        finally
        {
            refreshGate.Release();
            if (showLoading) Loading = false;
        }
    }
    private Task DraftChangedAsync(string code)
    {
        if (!string.Equals(code, ShareCode, StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;
        // Quem gravou a ação não pode esperar (nem falhar) por causa dos outros circuitos.
        _ = RefreshFromNotificationAsync();
        return Task.CompletedTask;
    }
    private async Task RefreshFromNotificationAsync()
    {
        try
        {
            await InvokeAsync(async () => { await LoadAsync(false); StateHasChanged(); });
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Falha ao aplicar a atualização recebida do draft {ShareCode}", ShareCode);
        }
    }
    private async Task RunClockAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var ticks = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(ClockCancellation.Token))
            {
                ticks++;
                try
                {
                    if (!IsActive)
                    {
                        // Sem relógio ativo não existe contagem para animar: a sala é atualizada por notificação.
                        if (ticks % 5 == 0) await InvokeAsync(StateHasChanged);
                        continue;
                    }

                    // O contador é local: repinta antes de consultar o servidor para o relógio nunca travar.
                    await InvokeAsync(StateHasChanged);
                    if (RemainingSeconds > 0 && ticks % 3 != 0) continue;
                    await LoadAsync(false);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception exception) when (exception is not OperationCanceledException)
                {
                    // Uma leitura com falha não pode encerrar o relógio da sala.
                    Logger.LogWarning(exception, "Falha ao atualizar o relógio do draft {ShareCode}", ShareCode);
                }
            }
        }
        catch (OperationCanceledException) { }
    }
    private async Task RunAsync(Func<Task<AgeNexus.Application.Drafts.CivilizationDraftOperationResult>> action)
    {
        await refreshGate.WaitAsync();
        try
        {
            commandInProgress = true;
            var result = await action();
            OperationFailed = !result.Succeeded;
            Message = result.Succeeded ? null : ErrorLabel(result.ErrorCode);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogError(exception, "Falha ao concluir uma ação do draft {ShareCode}", ShareCode);
            OperationFailed = true;
            Message = ErrorLabel(null);
        }
        finally
        {
            commandInProgress = false;
            refreshGate.Release();
        }

        try
        {
            await LoadAsync(!OperationFailed);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Falha ao atualizar a sala do draft {ShareCode}", ShareCode);
        }
    }
    private Task ToggleReadyAsync() => RunAsync(() => Drafts.SetReadyAsync(ShareCode, Profile!.Id, !(MyTeam?.RepresentativeReady ?? false)));
    private Task StartAsync() => RunAsync(() => Drafts.StartAsync(ShareCode, Profile!.Id));
    private Task CancelAsync() => RunAsync(() => Drafts.CancelAsync(ShareCode, Profile!.Id));
    private void SelectFactionAsync(Guid id)
    {
        if (!IsMyTurn || Draft is null) return;
        if (Draft.Phase == AgeNexus.Application.Drafts.CivilizationDraftPhase.Bans)
        {
            PendingFactionId = id;
            PendingAction = DraftAction.Ban;
        }
        else if (Draft.Phase == AgeNexus.Application.Drafts.CivilizationDraftPhase.Picks)
        {
            PendingFactionId = id;
            PendingAction = DraftAction.Pick;
        }
    }
    private async Task ConfirmPendingActionAsync()
    {
        if (!PendingFactionId.HasValue || !PendingAction.HasValue) return;
        var factionId = PendingFactionId.Value;
        var action = PendingAction.Value;
        CancelPendingAction();
        if (action == DraftAction.Ban) await RunAsync(() => Drafts.SubmitBanAsync(ShareCode, Profile!.Id, factionId));
        else await RunAsync(() => Drafts.SubmitPickAsync(ShareCode, Profile!.Id, factionId));
    }
    private void CancelPendingAction()
    {
        PendingFactionId = null;
        PendingAction = null;
    }
    private void ToggleFloatingStatus() => FloatingStatusCollapsed = !FloatingStatusCollapsed;
    private bool FactionDisabled(AgeNexus.Application.Drafts.CivilizationDraftFactionView faction) => !IsMyTurn || faction.IsBanned || faction.IsPicked;
    private async Task CopyLinkAsync() { await JavaScript.InvokeVoidAsync("ageNexusDraft.copy", Navigation.Uri); Copied = true; }
    private async Task DownloadImageAsync() { await JavaScript.InvokeVoidAsync("ageNexusDraft.download", new { Draft!.Title, Draft.MapName, Mode = ModeLabel(Draft.GameMode), Teams = Draft.Teams.Select(t => new { t.Name, Players = t.Players.Select(p => new { p.DisplayName }), Picks = t.Picks.Select(p => p.FactionName) }) }, $"draft-{Draft.ShareCode}.png"); }
    private static string PhaseLabel(AgeNexus.Application.Drafts.CivilizationDraftPhase phase) => phase switch { AgeNexus.Application.Drafts.CivilizationDraftPhase.Lobby => "Sala de espera", AgeNexus.Application.Drafts.CivilizationDraftPhase.Bans => "Bans", AgeNexus.Application.Drafts.CivilizationDraftPhase.Picks => "Picks", AgeNexus.Application.Drafts.CivilizationDraftPhase.Completed => "Concluído", _ => "Cancelado" };
    private static string ModeLabel(AgeNexus.Domain.Matches.MatchGameMode mode) => mode switch { AgeNexus.Domain.Matches.MatchGameMode.Conquest => "Conquista", AgeNexus.Domain.Matches.MatchGameMode.Regicide => "Regicídio", AgeNexus.Domain.Matches.MatchGameMode.KingOfTheHill => "Rei da Colina", AgeNexus.Domain.Matches.MatchGameMode.EmpireWars => "Guerras de Impérios", _ => mode == AgeNexus.Domain.Matches.MatchGameMode.Standard ? "Padrão" : mode.ToString() };
    private static string ErrorLabel(string? code) => code switch { "RepresentativesNotReady" => "Os dois representantes precisam confirmar presença.", "RepresentativeOnly" => "Somente o representante desta equipe pode confirmar presença.", "NotYourTurn" => "Aguarde a vez da outra equipe.", "FactionUnavailable" => "Essa civilização já foi banida ou escolhida.", "InvalidPick" => "Esta equipe já concluiu suas escolhas.", "OrganizerOnly" => "Somente o organizador pode fazer isso.", "ConcurrentChange" => "Outra ação chegou primeiro. A sala foi atualizada.", _ => "Não foi possível concluir esta ação." };
    private enum DraftAction { Ban, Pick }
    public void Dispose() { Notifier.Changed -= DraftChangedAsync; ClockCancellation.Cancel(); ClockCancellation.Dispose(); }
}
