@page "/jogadores/gerenciar"
@attribute [Authorize(Policy = "Administrator")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@inject AgeNexus.Infrastructure.Identity.AccountService Accounts

<PageTitle>Gerenciar jogadores · Age Nexus</PageTitle>
<LoadingOverlay Visible="@(IsLoading || Busy)" Message="Atualizando participantes..." />

<section class="page-heading compact-heading">
    <div>
        <span class="eyebrow">Gestão da comunidade</span>
        <h1>Participantes</h1>
        <p>Cadastre jogadores que participam das partidas, mesmo que ainda não tenham uma conta.</p>
    </div>
    <a class="button button-secondary" href="/jogadores">Ver jogadores</a>
</section>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="form-alert @(HasError ? "form-alert-error" : "form-alert-success")" role="status">@Message</div>
}

<div class="managed-players-layout">
    @if (Claims.Count > 0)
    {
        <section class="panel profile-form-card profile-claims-panel">
            <header class="panel-header">
                <div><span class="eyebrow">Vinculações pendentes</span><h2>@Claims.Count solicitação(ões)</h2></div>
            </header>
            <div class="managed-player-list">
                @foreach (var claim in VisibleClaims)
                {
                    <article class="managed-player-row profile-claim-row" @key="claim.ClaimId">
                        <PlayerAvatar DisplayName="@claim.DisplayName" Size="list" />
                        <div>
                            <strong>@claim.DisplayName</strong>
                            <small>@claim.AccountEmail</small>
                            <small>Solicitado em @claim.RequestedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="profile-claim-actions">
                            <button class="button button-primary button-compact" type="button" @onclick="() => DecideClaimAsync(claim.ClaimId, true)" disabled="@Busy">Aprovar</button>
                            <button class="table-action-button table-action-danger" type="button" @onclick="() => DecideClaimAsync(claim.ClaimId, false)" disabled="@Busy">Recusar</button>
                        </div>
                    </article>
                }
            </div>
            <PaginationNav CurrentPage="@CurrentClaimsPage" TotalItems="@Claims.Count" PageSize="@ClaimsPageSize" OnPageChanged="SetClaimsPage" />
        </section>
    }

    <section class="panel profile-form-card">
        <header class="panel-header">
            <div>
                <span class="eyebrow">@(Form.Id.HasValue ? "Editar jogador" : "Novo jogador")</span>
                <h2>@(Form.Id.HasValue ? Form.DisplayName : "Adicionar jogador")</h2>
            </div>
        </header>

        <EditForm Model="Form" OnValidSubmit="SaveAsync" class="account-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <label class="form-field">
                <span>Nome do jogador *</span>
                <InputText @bind-Value="Form.DisplayName" maxlength="100" placeholder="Ex.: Leandro, João, Player 3" />
                <ValidationMessage For="@(() => Form.DisplayName)" />
            </label>
            <div class="form-grid">
                <label class="form-field">
                    <span>Localização</span>
                    <InputText @bind-Value="Form.Location" maxlength="100" placeholder="Cidade ou região (opcional)" />
                </label>
                <label class="form-field">
                    <span>Link da foto</span>
                    <InputText @bind-Value="Form.AvatarUrl" maxlength="500" placeholder="https://... (opcional)" />
                </label>
            </div>
            <label class="form-field">
                <span>Observação pública</span>
                <InputTextArea @bind-Value="Form.Bio" maxlength="500" rows="3" placeholder="Apelido, estilo de jogo ou outra nota opcional" />
            </label>
            <div class="performance-actions">
                <button class="button button-primary" type="submit" disabled="@Busy">
                    @(Busy ? "Salvando..." : Form.Id.HasValue ? "Salvar alterações" : "Adicionar participante")
                </button>
                @if (Form.Id.HasValue)
                {
                    <button class="button button-secondary" type="button" @onclick="ResetForm" disabled="@Busy">Cancelar</button>
                }
            </div>
        </EditForm>
    </section>

    <section class="panel profile-form-card">
        <header class="panel-header">
            <div><span class="eyebrow">Elenco disponível</span><h2>@Profiles.Count jogador(es)</h2></div>
        </header>
        @if (Profiles.Count == 0)
        {
            <p>Nenhum perfil encontrado.</p>
        }
        else
        {
            <div class="managed-player-list">
                @foreach (var profile in VisibleProfiles)
                {
                    <article class="managed-player-row" @key="profile.Id">
                        <PlayerAvatar DisplayName="@profile.DisplayName" Url="@profile.AvatarUrl" Size="list" />
                        <div>
                            <strong>@profile.DisplayName</strong>
                            <small>@(profile.HasUserAccount ? "Perfil vinculado a uma conta" : "Ainda não vinculado a uma conta")</small>
                            @if (!string.IsNullOrWhiteSpace(profile.Location))
                            {
                                <small>@profile.Location</small>
                            }
                        </div>
                        @if (!profile.HasUserAccount)
                        {
                            <button class="button button-secondary button-compact" type="button" @onclick="() => Edit(profile)">Editar</button>
                        }
                    </article>
                }
            </div>
            <PaginationNav CurrentPage="@CurrentProfilesPage" TotalItems="@Profiles.Count" PageSize="@ProfilesPageSize" OnPageChanged="SetProfilesPage" />
        }
    </section>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private IReadOnlyCollection<AgeNexus.Infrastructure.Identity.ManagedPlayerProfile> Profiles { get; set; } = [];
    private IReadOnlyCollection<AgeNexus.Infrastructure.Identity.ManagedProfileClaim> Claims { get; set; } = [];
    private PlayerForm Form { get; set; } = new();
    private string? Message { get; set; }
    private bool HasError { get; set; }
    private bool Busy { get; set; }
    private bool IsLoading { get; set; } = true;
    private int ProfilesPage { get; set; } = 1;
    private int ClaimsPage { get; set; } = 1;
    private const int ProfilesPageSize = 10;
    private const int ClaimsPageSize = 5;
    private int CurrentProfilesPage => Math.Clamp(ProfilesPage, 1, Math.Max(1, (int)Math.Ceiling(Profiles.Count / (double)ProfilesPageSize)));
    private int CurrentClaimsPage => Math.Clamp(ClaimsPage, 1, Math.Max(1, (int)Math.Ceiling(Claims.Count / (double)ClaimsPageSize)));
    private IEnumerable<AgeNexus.Infrastructure.Identity.ManagedPlayerProfile> VisibleProfiles =>
        Profiles.Skip((CurrentProfilesPage - 1) * ProfilesPageSize).Take(ProfilesPageSize);
    private IEnumerable<AgeNexus.Infrastructure.Identity.ManagedProfileClaim> VisibleClaims =>
        Claims.Skip((CurrentClaimsPage - 1) * ClaimsPageSize).Take(ClaimsPageSize);

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        IsLoading = true;
        try
        {
            var authentication = await AuthenticationStateTask;
            Profiles = await Accounts.GetManagedProfilesAsync(authentication.User);
            Claims = await Accounts.GetPendingProfileClaimsAsync(authentication.User);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task SetProfilesPage(int page) { ProfilesPage = page; return Task.CompletedTask; }
    private Task SetClaimsPage(int page) { ClaimsPage = page; return Task.CompletedTask; }

    private async Task SaveAsync()
    {
        Busy = true;
        Message = null;
        var authentication = await AuthenticationStateTask;
        var editing = Form.Id.HasValue;
        var result = editing
            ? await Accounts.UpdateManagedProfileAsync(
                authentication.User, Form.Id!.Value, Form.DisplayName, Form.Bio, Form.Location, Form.AvatarUrl)
            : await Accounts.CreateManagedProfileAsync(
                authentication.User, Form.DisplayName, Form.Bio, Form.Location, Form.AvatarUrl);

        HasError = !result.Succeeded;
        Message = result.Succeeded
            ? (editing ? "Perfil atualizado." : "Participante adicionado e pronto para entrar em partidas.")
            : result.ErrorCodes.Contains("DuplicateDisplayName")
                ? "Já existe um jogador com esse nome."
                : "Não foi possível salvar. Revise o nome e o link da foto.";
        if (result.Succeeded)
        {
            ResetForm();
            await ReloadAsync();
        }
        Busy = false;
    }

    private void Edit(AgeNexus.Infrastructure.Identity.ManagedPlayerProfile profile)
    {
        Form = new PlayerForm
        {
            Id = profile.Id,
            DisplayName = profile.DisplayName,
            Bio = profile.Bio,
            Location = profile.Location,
            AvatarUrl = profile.AvatarUrl
        };
        Message = null;
    }

    private void ResetForm() => Form = new PlayerForm();

    private async Task DecideClaimAsync(Guid claimId, bool approve)
    {
        Busy = true;
        var authentication = await AuthenticationStateTask;
        var result = await Accounts.DecideProfileClaimAsync(authentication.User, claimId, approve);
        HasError = !result.Succeeded;
        Message = result.Succeeded
            ? (approve ? "Perfil vinculado à conta." : "Solicitação recusada.")
            : "Não foi possível decidir esta solicitação; talvez o perfil já tenha sido vinculado.";
        await ReloadAsync();
        Busy = false;
    }

    private sealed class PlayerForm
    {
        public Guid? Id { get; set; }

        [Required(ErrorMessage = "Informe o nome do jogador.")]
        [StringLength(100, ErrorMessage = "Use no máximo 100 caracteres.")]
        public string DisplayName { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Use no máximo 500 caracteres.")]
        public string? Bio { get; set; }

        [StringLength(100, ErrorMessage = "Use no máximo 100 caracteres.")]
        public string? Location { get; set; }

        [StringLength(500, ErrorMessage = "Use no máximo 500 caracteres.")]
        public string? AvatarUrl { get; set; }
    }
}
