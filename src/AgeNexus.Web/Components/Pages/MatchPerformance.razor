    private void ResetExtractorResults()
    {
        ExtractorCategoryResults.Clear();
        ExtractorCategoryErrors.Clear();
        ExtractorProgress = null;
        Message = "Resultados parciais descartados. As imagens e delimitações foram mantidas para uma nova extração.";
        HasError = false;
    }

    private async Task RemoveExtractorImageAsync(string category)
    {
        try
        {
            await JS.InvokeVoidAsync("ageNexusCropper.dispose", ExtractorCropperKey(category));
        }
        catch (Microsoft.JSInterop.JSException exception)
        {
            Logger.LogDebug(exception, "AgeXtractor cropper was already unavailable for {Category}", category);
        }

        ExtractorImages.Remove(category);
        var discardedResult = ExtractorCategoryResults.Remove(category);
        ExtractorCategoryErrors.Remove(category);
        PendingCropperInitialization.Remove(category);
        if (PendingCropperRefresh == category)
        {
            PendingCropperRefresh = null;
        }
        ExtractorInputVersions[category] = ExtractorInputVersions.GetValueOrDefault(category) + 1;
        if (ActiveCropCategory == category)
        {
            ActiveCropCategory = ExtractorCategories
                .Select(item => item.Key)
                .FirstOrDefault(ExtractorImages.ContainsKey);
            if (ActiveCropCategory is not null)
            {
                PendingCropperRefresh = ActiveCropCategory;
            }
        }
        ExtractorProgress = null;
        var label = ExtractorCategories.Single(item => item.Key == category).Label;
        Message = discardedResult
            ? $"Imagem de {label} removida. O resultado dessa categoria também foi descartado."
            : $"Imagem de {label} removida. Você já pode selecionar outra.";
        HasError = false;
    }

    private Task ExtractLoadedImagesAsync() => ExtractImagesAsync();

    private Task ExtractSingleImageAsync(string category) => ExtractImagesAsync(category);

    private async Task ExtractImagesAsync(string? onlyCategory = null)
    {
        if (Rows.Count is < 2 or > 8)
        {
            Message = "A partida precisa ter entre 2 e 8 participantes humanos para usar o extrator.";
            HasError = true;
            return;
        }

        var categories = ExtractorCategories
            .Where(category => ExtractorImages.ContainsKey(category.Key) &&
                (category.Key == onlyCategory || onlyCategory is null && !ExtractorCategoryResults.ContainsKey(category.Key)))
            .ToArray();
        if (categories.Length == 0)
        {
            Message = onlyCategory is null
                ? "Carregue ao menos uma imagem pendente para iniciar a extração."
                : "Carregue a imagem desta categoria antes de extraí-la.";
            HasError = true;
            return;
        }

        if (onlyCategory is not null)
        {
            ExtractorCategoryResults.Remove(onlyCategory);
            ExtractorCategoryErrors.Remove(onlyCategory);
        }
        Busy = true;
        Message = categories.Length == 1
            ? $"O AgeXtractor está lendo {categories[0].Label}."
            : "O AgeXtractor está lendo as imagens carregadas. Cada categoria concluída será preservada.";
        HasError = false;
        ExtractorProgress = new(
            ExtractorCategoryResults.Count,
            ExtractorCategories.Length,
            100m * ExtractorCategoryResults.Count / ExtractorCategories.Length,
            "Preparando as categorias pendentes");
        try
        {
            foreach (var category in categories)
            {
                double[][] points;
                try
                {
                    points = await JS.InvokeAsync<double[][]>(
                        "ageNexusCropper.getPoints", ExtractorCropperKey(category.Key));
                }
                catch (Microsoft.JSInterop.JSException exception)
                {
                    ExtractorCategoryErrors[category.Key] = "A imagem ainda não terminou de carregar para o ajuste.";
                    Logger.LogWarning(exception, "Failed to read AgeXtractor crop region for {Category}", category.Key);
                    continue;
                }

                var corners = points.Select(point =>
                    new AgeNexus.Application.MatchPerformance.AgeExtractorPoint(point[0], point[1])).ToArray();
                var image = new AgeNexus.Application.MatchPerformance.AgeExtractorImage(
                    category.Key,
                    ExtractorImages[category.Key].Content,
                    corners);
                var completedBefore = ExtractorCategoryResults.Count;
                ExtractorCategoryErrors.Remove(category.Key);
                var progress = new Progress<AgeNexus.Application.MatchPerformance.AgeExtractorProgress>(value =>
                {
                    var overallPercentage = 100m * (completedBefore + value.Percentage / 100m) / ExtractorCategories.Length;
                    ExtractorProgress = new(completedBefore, ExtractorCategories.Length, overallPercentage, value.Message);
                    _ = InvokeAsync(StateHasChanged);
                });
                var result = await AgeExtractorService.ExtractCategoryAsync(Rows.Count, image, progress);
                if (result.Succeeded && !string.IsNullOrWhiteSpace(result.Json))
                {
                    ExtractorCategoryResults[category.Key] = result.Json;
                    ExtractorProgress = new(
                        ExtractorCategoryResults.Count,
                        ExtractorCategories.Length,
                        100m * ExtractorCategoryResults.Count / ExtractorCategories.Length,
                        $"{category.Label} concluída");
                    continue;
                }

                ExtractorCategoryErrors[category.Key] = ExtractorFailureMessage(result);
                if (result.ErrorCode is "Busy" or "Timeout" or "Unavailable")
                {
                    break;
                }
            }

            if (ExtractorCategoryResults.Count != ExtractorCategories.Length)
            {
                var pending = ExtractorCategories
                    .Where(category => !ExtractorCategoryResults.ContainsKey(category.Key))
                    .Select(category => category.Label);
                Message = $"{ExtractorCategoryResults.Count} de 5 categorias concluídas. Ajuste e tente novamente: {string.Join(", ", pending)}.";
                HasError = ExtractorCategoryErrors.Count > 0;
                return;
            }

            var composition = JsonComposer.Compose(ExtractorCategoryResults.Values.ToArray());
            if (!composition.Succeeded || string.IsNullOrWhiteSpace(composition.Json))
            {
                Message = $"Não foi possível consolidar os resultados: {composition.Error}";
                HasError = true;
                return;
            }
            JsonText = string.Empty;
            JsonFileContent = composition.Json;
            JsonFileName = "Resultado do AgeXtractor online";
            await JS.InvokeVoidAsync("ageNexusCropper.disposeAll", ExtractorCropperPrefix);
            ExtractorImages.Clear();
            ExtractorCategoryResults.Clear();
            ExtractorCategoryErrors.Clear();
            ActiveCropCategory = null;
            AnalyzeJsonImport();
            if (!HasError)
            {
                ExtractorProgress = new(5, 5, 100, "Extração concluída");
                Message = "Extração concluída. Revise os valores e associe cada posição ao jogador correto.";
            }
        }
        catch (Exception exception)
        {
            Message = "A extração incremental foi interrompida inesperadamente. Os resultados já concluídos foram preservados.";
            HasError = true;
            Logger.LogError(exception, "Failed to run incremental AgeXtractor extraction");
        }
        finally
        {
            Busy = false;
        }
    }

    private static string ExtractorFailureMessage(
        AgeNexus.Application.MatchPerformance.AgeExtractorExecutionResult result)
    {
        var summary = result.ErrorCode switch
        {
            "Busy" => "O AgeXtractor já está processando outra partida.",
            "Timeout" => "A categoria ultrapassou o limite de cinco minutos.",
            "Unavailable" => "O AgeXtractor não está disponível neste servidor.",
            "InvalidImage" => "A imagem ou delimitação é inválida.",
            _ => "Não foi possível extrair esta categoria."
        };
        return string.IsNullOrWhiteSpace(result.ErrorMessage)
            ? summary
            : $"{summary} {result.ErrorMessage}";
    }

    private void AnalyzeJsonImport()
    {
        var hasFile = !string.IsNullOrWhiteSpace(JsonFileContent);
        var hasText = !string.IsNullOrWhiteSpace(JsonText);
        if (hasFile == hasText)
        {
            Message = hasFile
                ? "Escolha somente uma entrada: remova o arquivo ou apague o JSON colado."
                : "Selecione um arquivo JSON ou cole seu conteúdo completo.";
            HasError = true;
            return;
        }

        JsonImportResult = JsonImporter.Import(hasFile ? JsonFileContent! : JsonText);
        JsonMappings.Clear();
        if (JsonImportResult.CanApply)
        {
            JsonMappings.AddRange(JsonImportResult.Players.OrderBy(x => x.PlayerNumber).Select((player, index) =>
                new JsonPlayerMapping
                {
                    PlayerNumber = player.PlayerNumber,
                    PlayerProfileId = index < Rows.Count ? Rows[index].PlayerProfileId : null
                }));
        }
        HasError = JsonImportResult.Status == AgeNexus.Application.MatchPerformance.JsonImportStatus.Invalid;
        Message = JsonImportSummary;
    }

    private void ApplyJsonImport()
    {
        if (JsonImportResult?.CanApply != true)
        {
            return;
        }
        if (JsonImportResult.PlayerCount != Rows.Count)
        {
            Message = $"O JSON contém {JsonImportResult.PlayerCount} jogadores, mas a partida possui {Rows.Count} participantes humanos.";
            HasError = true;
            return;
        }
        if (JsonMappings.Any(x => !x.PlayerProfileId.HasValue) ||
            JsonMappings.Select(x => x.PlayerProfileId).Distinct().Count() != JsonMappings.Count)
        {
            Message = "Associe cada posição a um participante diferente da partida.";
            HasError = true;
            return;
        }

        foreach (var imported in JsonImportResult.Players)
        {
            var mapping = JsonMappings.Single(x => x.PlayerNumber == imported.PlayerNumber);
            Rows.Single(x => x.PlayerProfileId == mapping.PlayerProfileId).Apply(imported.Values);
        }

        Source = AgeNexus.Domain.MatchPerformance.MatchStatisticsSource.JsonImport;
        JsonImportDetails = System.Text.Json.JsonSerializer.Serialize(new
        {
            format = "AgeExtractor",
            importedAtUtc = DateTimeOffset.UtcNow,
            status = JsonImportResult.Status.ToString(),
            issueCount = JsonImportResult.Issues.Count,
            normalizationCount = JsonImportResult.Normalizations.Count
        });
        JsonText = string.Empty;
        JsonFileContent = null;
        HasError = false;
        Message = JsonImportResult.Status == AgeNexus.Application.MatchPerformance.JsonImportStatus.Partial
            ? "Estatísticas disponíveis preenchidas. Revise os campos vazios indicados antes de salvar."
            : "Todas as estatísticas do JSON foram preenchidas. Confira os participantes e informe o MVP de cada equipe.";
    }

    private void ClearJsonImport()
    {
        JsonText = string.Empty;
        JsonFileName = null;
        JsonFileContent = null;
        JsonImportResult = null;
        JsonMappings.Clear();
    }

    private static decimal? ResourceTotal(AgeNexus.Domain.MatchPerformance.MatchStatisticValues values) =>
        values.FoodCollected.HasValue && values.WoodCollected.HasValue && values.GoldCollected.HasValue && values.StoneCollected.HasValue
            ? (decimal)values.FoodCollected.Value + values.WoodCollected.Value + values.GoldCollected.Value + values.StoneCollected.Value
            : null;

    private static string UnitBalance(AgeNexus.Domain.MatchPerformance.MatchStatisticValues values) =>
        values.UnitsKilled.HasValue && values.UnitsLost.HasValue
            ? (values.UnitsKilled.Value - values.UnitsLost.Value).ToString("+#,0;-#,0;0")
            : "—";

    private static string FormatNumber(int? value) => value?.ToString("N0") ?? "—";
    private static string FormatNumber(decimal? value) => value?.ToString("N0") ?? "—";
    private static string FormatEra(int? seconds) => seconds.HasValue
        ? $"{seconds.Value / 3600:00}:{seconds.Value % 3600 / 60:00}:{seconds.Value % 60:00}"
        : "—";

    private static string PlayerMetric(
        AgeNexus.Application.MatchPerformance.ImportedPlayerStatistics? player,
        Func<AgeNexus.Domain.MatchPerformance.MatchStatisticValues, int?> selector) =>
        player is null ? "Sem dados" : $"Jogador {player.PlayerNumber} · {FormatNumber(selector(player.Values))}";

    private static string ResourceMetric(AgeNexus.Application.MatchPerformance.ImportedPlayerStatistics? player) =>
        player is null ? "Sem dados" : $"Jogador {player.PlayerNumber} · {FormatNumber(ResourceTotal(player.Values))}";

    private async Task SaveAsync()
    {
        if (CurrentProfile is null)
        {
            return;
        }

        if (Rows.Any(x => !x.HasValidEraTimes))
        {
            Message = "Nos horários das eras, minutos e segundos devem ficar entre 00 e 59.";
            HasError = true;
            return;
        }

        Busy = true;
        var result = await PerformanceService.SaveManualAsync(new(
            MatchId,
            CurrentProfile.Id,
            Source,
            Rows.Select(x => new AgeNexus.Application.MatchPerformance.SavePlayerStatistics(
                x.PlayerProfileId, x.ToValues(), AgeNexus.Domain.MatchPerformance.StatisticValueOrigin.Manual)).ToArray(),
            JsonImportDetails));
        SetResult(result, "Rascunho salvo.");
        await ReloadAsync();
        Busy = false;
    }

    private async Task SubmitAsync()
    {
        await SaveAsync();
        if (HasError || View?.ReportId is not Guid reportId || CurrentProfile is null)
        {
            return;
        }

        Busy = true;
        var result = await PerformanceService.SubmitAsync(reportId, CurrentProfile.Id);
        SetResult(result, "Relatório confirmado pelo administrador e partida validada.");
        await ReloadAsync();
        Busy = false;
    }

    private Task ConfirmAsync() => DecideAsync(AgeNexus.Domain.MatchPerformance.StatisticsConfirmationDecision.Confirmed);
    private Task ContestAsync() => DecideAsync(AgeNexus.Domain.MatchPerformance.StatisticsConfirmationDecision.Contested);

    private async Task DecideAsync(AgeNexus.Domain.MatchPerformance.StatisticsConfirmationDecision decision)
    {
        if (View?.ReportId is not Guid reportId || CurrentProfile is null)
        {
            return;
        }

        Busy = true;
        var result = await PerformanceService.ConfirmAsync(reportId, CurrentProfile.Id, decision);
        SetResult(result, decision == AgeNexus.Domain.MatchPerformance.StatisticsConfirmationDecision.Confirmed
            ? "Estatísticas confirmadas pela sua equipe."
            : "Relatório contestado e retirado da pontuação.");
        await ReloadAsync();
        Busy = false;
    }

    private async Task FinalizeAsync()
    {
        var authentication = await AuthenticationStateTask;
        if (!await Accounts.IsAdministratorAsync(authentication.User))
        {
            HasError = true;
            Message = "Sua conta não possui permissão para finalizar estatísticas.";
            return;
        }

        if (View?.ReportId is not Guid reportId)
        {
            return;
        }

        Busy = true;
        var result = await PerformanceService.FinalizeAsync(reportId);
        SetResult(result, "MVPs informados pelo jogo e bônus aplicados.");
        await ReloadAsync();
        Busy = false;
    }

    private async Task ReopenAsync()
    {
        if (View?.ReportId is not Guid reportId || CurrentProfile is null)
        {
            return;
        }

        Busy = true;
        var result = await PerformanceService.ReopenAsync(reportId, CurrentProfile.Id);
        SetResult(result, "Relatório reaberto. Corrija os dados e envie novamente.");
        await ReloadAsync();
        Busy = false;
    }

    private void SetTeamMvp(Guid teamId, Guid playerProfileId)
    {
        foreach (var player in Rows.Where(x => x.TeamId == teamId))
        {
            player.IsTeamMvp = player.PlayerProfileId == playerProfileId;
        }
    }

    private void SetResult(AgeNexus.Application.MatchPerformance.PerformanceOperationResult result, string success)
    {
        HasError = !result.Succeeded;
        Message = result.Succeeded
            ? string.Join(" ", new[] { success }.Concat(result.Warnings ?? []))
            : result.ErrorCode switch
            {
                "MatchMustBeValidated" or "MatchCouldNotBeValidated" => "A partida não pôde ser validada. Revise os resultados informados para as equipes.",
                "ReportIsIncomplete" => "Preencha todos os campos obrigatórios de todos os jogadores antes de calcular.",
                "ReportMustBeConfirmed" => "O relatório ainda não está confirmado.",
                "TeamMvpRequired" => "Selecione exatamente um MVP em cada equipe antes de enviar.",
                _ => $"Não foi possível concluir: {result.ErrorCode}."
            };
    }

    private static string AwardLabel(AgeNexus.Domain.MatchPerformance.PerformanceAwardType? award) => award switch
    {
        AgeNexus.Domain.MatchPerformance.PerformanceAwardType.Mvp => "MVP da equipe",
        AgeNexus.Domain.MatchPerformance.PerformanceAwardType.SharedMvp => "MVP compartilhado",
        AgeNexus.Domain.MatchPerformance.PerformanceAwardType.DefeatedTeamHighlight => "Destaque da derrota",
        _ => ""
    };

