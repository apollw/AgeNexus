    }

    public sealed class EraTimeForm
    {
        public int? Hours { get; set; }
        public int? Minutes { get; set; }
        public int? Seconds { get; set; }

        public int? ToTotalSeconds() =>
            !Hours.HasValue && !Minutes.HasValue && !Seconds.HasValue
                ? null
                : (Hours ?? 0) * 3600 + (Minutes ?? 0) * 60 + (Seconds ?? 0);

        public bool IsValid =>
            Hours is null or (>= 0 and <= 99) &&
            Minutes is null or (>= 0 and <= 59) &&
            Seconds is null or (>= 0 and <= 59);

        public static EraTimeForm FromTotalSeconds(int? total) => total.HasValue
            ? new EraTimeForm
            {
                Hours = total.Value / 3600,
                Minutes = total.Value % 3600 / 60,
                Seconds = total.Value % 60
            }
            : new EraTimeForm();
    }
