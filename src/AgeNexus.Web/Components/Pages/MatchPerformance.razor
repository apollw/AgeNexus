        }
    }

    private async Task ReadJsonFileAsync(InputFileChangeEventArgs args)
    {
        Busy = true;
        try
        {
            await using var input = args.File.OpenReadStream(1024 * 1024);
            using var reader = new StreamReader(input, System.Text.Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            JsonFileContent = await reader.ReadToEndAsync();
            JsonFileName = args.File.Name;
            JsonImportResult = null;
            JsonMappings.Clear();
            Message = $"Arquivo {args.File.Name} carregado. Clique em Validar JSON.";
            HasError = false;
        }
        catch (IOException)
        {
            JsonFileContent = null;
            JsonFileName = null;
            Message = "O JSON excede o limite de 1 MB ou não pôde ser lido.";
            HasError = true;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ReadExtractorImageAsync(InputFileChangeEventArgs args, string category)
    {
        Busy = true;
        try
        {
            await using var input = args.File.OpenReadStream(5 * 1024 * 1024);
            using var memory = new MemoryStream();
            await input.CopyToAsync(memory);
            ExtractorImages[category] = new(args.File.Name, memory.ToArray());
            ExtractorCategoryResults.Remove(category);
            ExtractorCategoryErrors.Remove(category);
            ActiveCropCategory = category;
            PendingCropperInitialization.Add(category);
            ExtractorProgress = null;
            Message = $"Imagem de {ExtractorCategories.Single(x => x.Key == category).Label} carregada. Ajuste os quatro cantos da tabela.";
            HasError = false;
        }
        catch (IOException)
        {
            ExtractorImages.Remove(category);
            ExtractorCategoryResults.Remove(category);
            ExtractorCategoryErrors.Remove(category);
            Message = "A imagem ultrapassa 5 MB ou não pôde ser lida.";
            HasError = true;
        }
        finally
        {
            Busy = false;
        }
    }

