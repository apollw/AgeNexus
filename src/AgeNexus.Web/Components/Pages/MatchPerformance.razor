@page "/partidas/{MatchId:guid}/desempenho"
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "Administrator")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject AgeNexus.Application.MatchPerformance.IPerformanceStatisticsService PerformanceService
@inject AgeNexus.Application.MatchPerformance.AgeExtractorJsonImporter JsonImporter
@inject AgeNexus.Application.MatchPerformance.AgeExtractorJsonComposer JsonComposer
@inject AgeNexus.Application.MatchPerformance.IAgeExtractorService AgeExtractorService
@inject AgeNexus.Application.Evidence.IMatchEvidenceService EvidenceService
@inject AgeNexus.Infrastructure.Identity.AccountService Accounts
@inject ILogger<MatchPerformance> Logger
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Desempenho da partida · Age Nexus</PageTitle>

<section class="page-heading compact-heading">
    <div>
        <span class="eyebrow">Relatório pós-jogo</span>
        <h1>Desempenho e MVP</h1>
        <p>Preencha as estatísticas manualmente ou importe o JSON do AgeExtractor. O replay é armazenado separadamente para download e não altera os dados do relatório.</p>
    </div>
    <a class="button button-secondary" href="/partidas">Voltar</a>
</section>

@if (IsLoading)
{
    <section class="panel panel-empty page-empty" role="status"><strong>Carregando partida...</strong></section>
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <section class="panel panel-empty page-empty load-failure" role="alert">
        <strong>Não foi possível carregar a partida</strong>
        <p>@LoadError</p>
        <button class="button button-primary" type="button" @onclick="LoadPageAsync">Tentar novamente</button>
    </section>
}
else if (View is null)
{
    <section class="panel panel-empty page-empty" role="alert"><strong>Partida não encontrada.</strong><a class="button button-secondary" href="/partidas">Voltar às partidas</a></section>
}
else if (CurrentProfile is null)
{
    <section class="panel panel-empty page-empty" role="alert"><strong>Sua conta ainda não possui um perfil de jogador vinculado.</strong><a class="button button-primary" href="/conta/vincular-perfil">Configurar perfil</a></section>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="form-alert @(HasError ? "form-alert-error" : "form-alert-success")">@Message</div>
    }

    <section class="panel performance-summary">
        <div><span class="eyebrow">Partida</span><strong>@View.Category</strong><small>Status: @View.MatchStatus</small></div>
        <div><span class="eyebrow">Relatório</span><strong>@(View.Status?.ToString() ?? "Não criado")</strong><small>Origem: @(View.Source?.ToString() ?? "a definir")</small></div>
        <div><span class="eyebrow">Completude</span><strong>@(View.IsComplete ? "Completo" : "Pendente")</strong><small>@View.ConfirmedTeamIds.Count equipe(s) confirmaram</small></div>
    </section>

    <section class="panel profile-form-card replay-import replay-file-upload">
        <header class="panel-header">
            <div><span class="eyebrow">Arquivo da partida</span><h2>Replay para download</h2></div>
            @if (EvidenceReplay is not null)
            {
                <a class="button button-secondary" href="/partidas/@MatchId/evidencias">Abrir página pública</a>
            }
        </header>
        <p>Envie o replay original para que outros jogadores possam baixá-lo depois. Este arquivo não preenche, corrige ou valida nenhuma estatística.</p>
        <div class="evidence-upload-row">
            <InputFile OnChange="UploadReplayAsync" accept=".aoe2record,.mgz,.mgx" disabled="@Busy" />
            <small>Formatos aceitos: <code>.aoe2record</code>, <code>.mgz</code> e <code>.mgx</code>, com até 50 MB. Um novo envio substitui o replay anterior.</small>
        </div>
        @if (EvidenceReplay is not null)
        {
            <div class="evidence-managed-item replay-managed-item">
                <a href="@EvidenceReplay.Url" download="@EvidenceReplay.FileName">↓ @(EvidenceReplay.FileName ?? "Baixar replay")</a>
                <button class="table-action-button table-action-danger" type="button" @onclick="() => DeleteEvidenceAsync(EvidenceReplay.EvidenceId)" disabled="@Busy">Remover</button>
            </div>
        }
    </section>

    @if (View.Status is null or AgeNexus.Domain.MatchPerformance.MatchStatisticsStatus.Draft)
    {
        <section class="panel profile-form-card online-extractor">
            <header class="panel-header">
                <div><span class="eyebrow">AgeXtractor online</span><h2>Extrair estatísticas das capturas</h2></div>
                <span class="extractor-player-count">@Rows.Count jogador(es)</span>
            </header>
            <p>Carregue e extraia as telas uma por vez ou em conjunto. Ajuste os quatro cantos para manter somente a tabela de cada imagem. O JSON só será criado após as cinco categorias serem concluídas.</p>
            <div class="extractor-file-grid">
                @foreach (var category in ExtractorCategories)
                {
                    <div class="extractor-file-card">
                        <label class="extractor-file-picker @(ExtractorImages.ContainsKey(category.Key) ? "extractor-file-ready" : null)">
                            <span>@category.Label</span>
                            <InputFile @key="ExtractorInputVersion(category.Key)"
                                       OnChange="@(args => ReadExtractorImageAsync(args, category.Key))"
                                       id="@ExtractorInputId(category.Key)"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" disabled="@Busy" />
                            <small>@ExtractorFileName(category.Key)</small>
                        </label>
                        @if (ExtractorImages.ContainsKey(category.Key))
                        {
                            <button class="extractor-remove-image" type="button"
                                    @onclick="() => RemoveExtractorImageAsync(category.Key)" disabled="@Busy">
                                Remover imagem
                            </button>
                        }
                    </div>
                }
            </div>
            @if (ExtractorImages.Count > 0)
            {
                <div class="extractor-crop-section">
                    <div class="extractor-crop-tabs" aria-label="Imagens carregadas para ajuste">
                        @foreach (var category in ExtractorCategories.Where(category => ExtractorImages.ContainsKey(category.Key)))
                        {
                            <button class="@(ActiveCropCategory == category.Key ? "active" : null)" type="button"
                                    @onclick="() => ActivateCropper(category.Key)" disabled="@Busy">
                                <span>@category.Label</span><small class="@ExtractorCategoryStatusClass(category.Key)">@ExtractorCategoryStatus(category.Key)</small>
                            </button>
                        }
                    </div>
                    @foreach (var category in ExtractorCategories.Where(category => ExtractorImages.ContainsKey(category.Key)))
                    {
                        <div class="extractor-crop-workspace @(ActiveCropCategory == category.Key ? null : "extractor-crop-hidden")">
                            <div>
                                <strong>Ajuste da tabela · @category.Label</strong>
                                <small>Arraste os pontos 1–4 até os cantos externos da tabela, incluindo o cabeçalho e a legenda inferior.</small>
                            </div>
                            <canvas id="@ExtractorCanvasId(category.Key)" aria-label="Ajuste dos quatro cantos da tabela de @category.Label"></canvas>
                            <div class="extractor-category-actions">
                                <button class="button button-primary" type="button"
                                        @onclick="() => ExtractSingleImageAsync(category.Key)"
                                        disabled="@(Busy || Rows.Count is < 2 or > 8)">
                                    @(ExtractorCategoryResults.ContainsKey(category.Key) ? $"Extrair {category.Label} novamente" : $"Extrair {category.Label}")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (ExtractorProgress is not null)
            {
                <div class="extractor-progress" role="status" aria-live="polite">
                    <div>
                        <strong>@ExtractorProgress.Message</strong>
                        <span>@ExtractorProgress.Percentage.ToString("N1")%</span>
                    </div>
                    <progress max="100" value="@ExtractorProgress.Percentage">@ExtractorProgress.Percentage%</progress>
                    <small>@ExtractorProgress.Completed de @ExtractorProgress.Total categorias concluídas</small>
                </div>
            }
            @if (ExtractorCategoryErrors.Count > 0)
            {
                <div class="extractor-category-errors" role="alert">
                    @foreach (var category in ExtractorCategories.Where(category => ExtractorCategoryErrors.ContainsKey(category.Key)))
                    {
                        <div><strong>@category.Label</strong><span>@ExtractorCategoryErrors[category.Key]</span></div>
                    }
                </div>
            }
            <div class="performance-actions extractor-actions">
                <small>@ExtractorImages.Count de 5 imagens carregadas · @ExtractorCategoryResults.Count de 5 categorias concluídas. Nenhuma captura é salva no banco.</small>
                @if (ExtractorCategoryResults.Count > 0 || ExtractorCategoryErrors.Count > 0)
                {
                    <button class="button button-secondary" type="button" @onclick="ResetExtractorResults" disabled="@Busy">Descartar resultados e recomeçar</button>
                }
                <button class="button button-primary" type="button" @onclick="ExtractLoadedImagesAsync"
                        disabled="@(Busy || !HasLoadedPendingCategories || Rows.Count is < 2 or > 8)">
                    @(Busy ? "Processando..." : "Extrair imagens carregadas")
                </button>
            </div>
        </section>

        <section class="panel profile-form-card json-import">
            <header class="panel-header">
                <div><span class="eyebrow">AgeExtractor</span><h2>Importar resultado JSON</h2></div>
                @if (JsonImportResult is not null)
                {
                    <button class="table-action-button" type="button" @onclick="ClearJsonImport">Limpar</button>
                }
            </header>
            <p>Envie o arquivo <code>resultado.json</code> gerado pelo AgeExtractor ou cole abaixo seu conteúdo completo. O arquivo pode ter outro nome.</p>
            <div class="json-import-inputs">
                <label class="json-file-picker">
                    <span>Selecionar arquivo JSON</span>
                    <InputFile OnChange="ReadJsonFileAsync" accept=".json,application/json" disabled="@Busy" />
                    <small>@(JsonFileName ?? "Nenhum arquivo selecionado")</small>
                </label>
                <span class="json-import-or">ou</span>
                <label class="form-field json-paste-field">
                    <span>Colar JSON</span>
                    <InputTextArea @bind-Value="JsonText" placeholder="Cole aqui o conteúdo completo, incluindo quantidade_jogadores e jogadores." disabled="@Busy" />
                </label>
            </div>
            <div class="performance-actions json-import-actions">
                <button class="button button-secondary" type="button" @onclick="AnalyzeJsonImport" disabled="@Busy">Validar JSON</button>
            </div>

            @if (JsonImportResult is not null)
            {
                <div class="json-import-summary json-import-@JsonImportResult.Status.ToString().ToLowerInvariant()">
                    <strong>@JsonImportSummary</strong>
                    <span>@JsonImportResult.Players.Count jogador(es) identificado(s) · @JsonImportResult.Issues.Count problema(s) · @JsonImportResult.Normalizations.Count normalização(ões)</span>
                </div>

                @if (JsonImportResult.CanApply)
                {
                    var totalLeader = JsonImportResult.Players.Where(x => x.Values.TotalScore.HasValue).OrderByDescending(x => x.Values.TotalScore).FirstOrDefault();
                    var militaryLeader = JsonImportResult.Players.Where(x => x.Values.UnitsKilled.HasValue).OrderByDescending(x => x.Values.UnitsKilled).FirstOrDefault();
                    var economyLeader = JsonImportResult.Players.Where(x => ResourceTotal(x.Values).HasValue).OrderByDescending(x => ResourceTotal(x.Values)).FirstOrDefault();
                    <div class="json-import-highlights">
                        <div><small>Maior pontuação</small><strong>@PlayerMetric(totalLeader, x => x.TotalScore)</strong></div>
                        <div><small>Mais eliminações</small><strong>@PlayerMetric(militaryLeader, x => x.UnitsKilled)</strong></div>
                        <div><small>Mais recursos</small><strong>@ResourceMetric(economyLeader)</strong></div>
                    </div>
                    <div class="json-comparison-wrap">
                        <table class="json-comparison">
                            <thead><tr><th>Posição</th><th>Pontuação</th><th>Eliminações</th><th>Perdas</th><th>Saldo</th><th>4 recursos</th><th>Feudal</th></tr></thead>
                            <tbody>
                                @foreach (var player in JsonImportResult.Players.OrderBy(x => x.PlayerNumber))
                                {
                                    <tr>
                                        <th>Jogador @player.PlayerNumber</th>
                                        <td>@FormatNumber(player.Values.TotalScore)</td>
                                        <td>@FormatNumber(player.Values.UnitsKilled)</td>
                                        <td>@FormatNumber(player.Values.UnitsLost)</td>
                                        <td>@UnitBalance(player.Values)</td>
                                        <td>@FormatNumber(ResourceTotal(player.Values))</td>
                                        <td>@FormatEra(player.Values.FeudalAgeSeconds)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (JsonImportResult.CanApply)
                {
                    <div class="json-player-mapping">
                        <header><strong>Associe as posições aos participantes</strong><small>Confira a ordem exibida pelo AgeExtractor antes de preencher o formulário.</small></header>
                        @foreach (var mapping in JsonMappings.OrderBy(x => x.PlayerNumber))
                        {
                            <label class="form-field">
                                <span>Jogador @mapping.PlayerNumber</span>
                                <InputSelect @bind-Value="mapping.PlayerProfileId">
                                    <option value="">Selecione um participante</option>
                                    @foreach (var row in Rows)
                                    {
                                        <option value="@row.PlayerProfileId">@row.DisplayName · equipe @row.TeamPosition</option>
                                    }
                                </InputSelect>
                            </label>
                        }
                    </div>
                    <button class="button button-primary" type="button" @onclick="ApplyJsonImport" disabled="@Busy">Preencher estatísticas</button>
                }

                @if (JsonImportResult.Issues.Count > 0)
                {
                    <details class="json-import-issues" open="@(JsonImportResult.Status == AgeNexus.Application.MatchPerformance.JsonImportStatus.Invalid)">
                        <summary>Revisar problemas encontrados</summary>
                        <div class="json-issue-list">
                            @foreach (var issue in JsonImportResult.Issues)
                            {
                                <article class="json-issue json-issue-@issue.Severity.ToString().ToLowerInvariant()">
                                    <strong>@(issue.PlayerNumber.HasValue ? $"Jogador {issue.PlayerNumber}" : "Documento") · @issue.Path</strong>
                                    <span>@issue.Reason @issue.Effect</span>
                                    @if (!string.IsNullOrWhiteSpace(issue.OriginalValue))
                                    {
                                        <code>@issue.OriginalValue</code>
                                    }
                                </article>
                            }
                        </div>
                    </details>
                }
            }
        </section>

        <EditForm Model="Rows">
        <section class="panel profile-form-card">
            <header class="panel-header">
                <div><span class="eyebrow">Entrada alternativa</span><h2>Estatísticas finais</h2></div>
                <InputSelect @bind-Value="Source" disabled="@(View.Source is AgeNexus.Domain.MatchPerformance.MatchStatisticsSource.Replay or AgeNexus.Domain.MatchPerformance.MatchStatisticsSource.ReplayWithManualCompletion)">
                    <option value="@AgeNexus.Domain.MatchPerformance.MatchStatisticsSource.Manual">Manual confirmada</option>
                    <option value="@AgeNexus.Domain.MatchPerformance.MatchStatisticsSource.ScreenshotTranscription">Transcrição de capturas</option>
                    @if (Source == AgeNexus.Domain.MatchPerformance.MatchStatisticsSource.JsonImport)
                    {
                        <option value="@AgeNexus.Domain.MatchPerformance.MatchStatisticsSource.JsonImport">JSON do AgeExtractor</option>
                    }
                </InputSelect>
            </header>
            <p class="performance-guidance">Marque exatamente um MVP por equipe, conforme indicado pelo jogo. O Age Nexus usa essa escolha manual ao conceder os bônus.</p>

            @foreach (var row in Rows)
            {
                <article class="performance-player" @key="row.PlayerProfileId">
                    <header class="performance-player-header">
                        <div><span class="eyebrow">@row.TeamResult · equipe @row.TeamPosition</span><h3>@row.DisplayName</h3></div>
                        <label class="mvp-choice">
                            <input type="radio" name="mvp-@row.TeamId" checked="@row.IsTeamMvp"
                                   @onchange="() => SetTeamMvp(row.TeamId, row.PlayerProfileId)" />
                            <span>MVP da equipe</span>
                        </label>
                    </header>
                    <div class="performance-fields">
                        <fieldset><legend>Militar</legend>
                            <label class="form-field"><span>Unidades eliminadas *</span><InputNumber @bind-Value="row.UnitsKilled" /></label>
                            <label class="form-field"><span>Unidades perdidas *</span><InputNumber @bind-Value="row.UnitsLost" /></label>
                            <label class="form-field"><span>Edifícios destruídos *</span><InputNumber @bind-Value="row.BuildingsDestroyed" /></label>
                            <label class="form-field"><span>Edifícios perdidos *</span><InputNumber @bind-Value="row.BuildingsLost" /></label>
                            <label class="form-field"><span>Maior exército *</span><InputNumber @bind-Value="row.LargestArmy" /></label>
                            <label class="form-field"><span>Conversões</span><InputNumber @bind-Value="row.UnitsConverted" /></label>
                            <label class="form-field"><span>Pontuação militar *</span><InputNumber @bind-Value="row.MilitaryScore" /></label>
                        </fieldset>
                        <fieldset><legend>Economia</legend>
                            <label class="form-field"><span>Comida *</span><InputNumber @bind-Value="row.FoodCollected" /></label>
                            <label class="form-field"><span>Madeira *</span><InputNumber @bind-Value="row.WoodCollected" /></label>
                            <label class="form-field"><span>Ouro *</span><InputNumber @bind-Value="row.GoldCollected" /></label>
                            <label class="form-field"><span>Pedra *</span><InputNumber @bind-Value="row.StoneCollected" /></label>
                            <label class="form-field"><span>Ouro comercial</span><InputNumber @bind-Value="row.TradeGold" /></label>
                            <label class="form-field"><span>Ouro de relíquias</span><InputNumber @bind-Value="row.RelicGold" /></label>
                            <label class="form-field"><span>Tributo enviado</span><InputNumber @bind-Value="row.TributeSent" /></label>
                            <label class="form-field"><span>Tributo recebido</span><InputNumber @bind-Value="row.TributeReceived" /></label>
                            <label class="form-field"><span>Pontuação econômica *</span><InputNumber @bind-Value="row.EconomyScore" /></label>
                        </fieldset>
                        <fieldset><legend>Tecnologia</legend>
                            <label class="form-field"><span>Tecnologias</span><InputNumber @bind-Value="row.ResearchCount" /></label>
                            <label class="form-field"><span>Pesquisas concluídas (%)</span><InputNumber @bind-Value="row.ResearchPercent" step="0.01" /></label>
                            <label class="form-field"><span>Mapa explorado (%)</span><InputNumber @bind-Value="row.ExploredPercent" /></label>
                            <label class="form-field"><span>Pontuação tecnológica *</span><InputNumber @bind-Value="row.TechnologyScore" /></label>
                            <div class="form-field era-time-field"><span>Chegada à Era Feudal (hh:mm:ss)</span><EraTimeInputs Value="row.FeudalAge" /></div>
                            <div class="form-field era-time-field"><span>Chegada à Era dos Castelos (hh:mm:ss)</span><EraTimeInputs Value="row.CastleAge" /></div>
                            <div class="form-field era-time-field"><span>Chegada à Era Imperial (hh:mm:ss)</span><EraTimeInputs Value="row.ImperialAge" /></div>
                        </fieldset>
                        <fieldset><legend>Sociedade e placar</legend>
                            <label class="form-field"><span>Máximo de aldeões *</span><InputNumber @bind-Value="row.PeakVillagers" /></label>
                            <label class="form-field"><span>Maravilhas construídas</span><InputNumber @bind-Value="row.WondersBuilt" /></label>
                            <label class="form-field"><span>Castelos construídos</span><InputNumber @bind-Value="row.CastlesBuilt" /></label>
                            <label class="form-field"><span>Relíquias capturadas</span><InputNumber @bind-Value="row.RelicsCaptured" /></label>
                            <label class="form-field"><span>Sobreviveu até o fim</span><InputSelect @bind-Value="row.Survived"><option value="">Não informado</option><option value="true">Sim</option><option value="false">Não</option></InputSelect></label>
                            <label class="form-field"><span>Pontuação social *</span><InputNumber @bind-Value="row.SocietyScore" /></label>
                            <label class="form-field"><span>Pontuação total *</span><InputNumber @bind-Value="row.TotalScore" /></label>
                        </fieldset>
                    </div>
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="form-alert @(HasError ? "form-alert-error" : "form-alert-success")" role="status">@Message</div>
            }
            <div class="performance-actions">
                <button class="button button-secondary" type="button" @onclick="SaveAsync" disabled="@Busy">Salvar rascunho</button>
                <button class="button button-primary" type="button" @onclick="SubmitAsync" disabled="@Busy">Salvar e enviar para confirmação</button>
            </div>
            <small>* Campos obrigatórios para o cálculo do MVP.</small>
        </section>
        </EditForm>
    }
    else
    {
        <section class="panel profile-form-card">
            <header class="panel-header"><div><span class="eyebrow">Resultado calculado</span><h2>Placar de desempenho</h2></div></header>
            <div class="performance-results">
                @foreach (var player in View.Players.OrderByDescending(x => x.PerformanceIndex ?? -1m))
                {
                    <div class="performance-result">
                        <div><strong>@player.DisplayName</strong><small>@player.TeamResult</small></div>
                        <span>@(player.PerformanceIndex?.ToString("P1") ?? "Aguardando cálculo")</span>
                        <b>@AwardLabel(player.AwardType) @(player.BonusPoints > 0 ? $"+{player.BonusPoints}" : "")</b>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="form-alert @(HasError ? "form-alert-error" : "form-alert-success")" role="status">@Message</div>
            }
            <div class="performance-actions">
                @if (CanConfirm)
                {
                    <button class="button button-primary" type="button" @onclick="ConfirmAsync" disabled="@Busy">Confirmar estatísticas pela equipe</button>
                    <button class="button button-secondary" type="button" @onclick="ContestAsync" disabled="@Busy">Contestar</button>
                }
                @if (View.Status == AgeNexus.Domain.MatchPerformance.MatchStatisticsStatus.Confirmed)
                {
                    <button class="button button-primary" type="button" @onclick="FinalizeAsync" disabled="@Busy">Aplicar MVPs e conceder bônus</button>
                }
                @if (CurrentProfile is not null)
                {
                    <button class="button button-secondary" type="button" @onclick="ReopenAsync" disabled="@Busy">Editar dados e MVPs</button>
                }
            </div>
        </section>
    }

    <section class="panel profile-form-card evidence-manager">
        <header class="panel-header">
            <div><span class="eyebrow">Comprovação</span><h2>Vídeo e capturas</h2></div>
            @if (EvidenceGallery?.Items.Count > 0)
            {
                <a class="button button-secondary" href="/partidas/@MatchId/evidencias">Visualizar página pública</a>
            }
        </header>
        <p>Adicione uma transmissão do YouTube ou até 5 capturas das telas finais. As imagens podem ser JPEG, PNG ou WebP, com no máximo 4 MB cada.</p>

        <div class="evidence-video-form">
            <label class="form-field">
                <span>Link do YouTube</span>
                <InputText @bind-Value="YouTubeUrl" placeholder="https://www.youtube.com/watch?v=..." />
            </label>
            <button class="button button-secondary" type="button" @onclick="SaveYouTubeAsync" disabled="@Busy">Salvar vídeo</button>
        </div>

        @if (EvidenceVideo is not null)
        {
            <div class="evidence-managed-item">
                <a href="@EvidenceVideo.Url" target="_blank" rel="noopener noreferrer">▶ Vídeo vinculado no YouTube</a>
                <button class="table-action-button table-action-danger" type="button" @onclick="() => DeleteEvidenceAsync(EvidenceVideo.EvidenceId)" disabled="@Busy">Remover</button>
            </div>
        }

        <div class="evidence-upload-row">
            <InputFile OnChange="UploadScreenshotsAsync" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple disabled="@Busy" />
            <small>Os arquivos são enviados ao Supabase Storage e não ocupam o banco PostgreSQL.</small>
        </div>

        @if (EvidenceScreenshots.Count > 0)
        {
            <div class="evidence-manager-grid">
                @foreach (var screenshot in EvidenceScreenshots)
                {
                    <article>
                        <a href="@screenshot.Url" target="_blank" rel="noopener noreferrer">
                            <img src="@screenshot.Url" alt="Captura das estatísticas" loading="lazy" decoding="async" />
                        </a>
                        <button class="table-action-button table-action-danger" type="button" @onclick="() => DeleteEvidenceAsync(screenshot.EvidenceId)" disabled="@Busy">Remover</button>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public Guid MatchId { get; set; }
    [SupplyParameterFromQuery(Name = "novo")] private string? NewMatch { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private AgeNexus.Application.MatchPerformance.PerformanceReportView? View { get; set; }
    private AgeNexus.Infrastructure.Identity.PublicProfile? CurrentProfile { get; set; }
