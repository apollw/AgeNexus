            GoldCollected = value.GoldCollected; StoneCollected = value.StoneCollected;
            MilitaryScore = value.MilitaryScore; EconomyScore = value.EconomyScore;
            TechnologyScore = value.TechnologyScore; SocietyScore = value.SocietyScore;
            TotalScore = value.TotalScore; UnitsConverted = value.UnitsConverted;
            TradeGold = value.TradeGold; RelicGold = value.RelicGold;
            TributeSent = value.TributeSent; TributeReceived = value.TributeReceived;
            ResearchCount = value.ResearchCount; ExploredPercent = value.ExploredPercent;
            FeudalAge = EraTimeForm.FromTotalSeconds(value.FeudalAgeSeconds);
            CastleAge = EraTimeForm.FromTotalSeconds(value.CastleAgeSeconds);
