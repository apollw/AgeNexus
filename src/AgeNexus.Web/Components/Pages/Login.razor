@page "/conta/login"

<PageTitle>Entrar · Age Nexus</PageTitle>

<section class="account-shell">
    <div class="account-intro">
        <span class="eyebrow">Sua mesa continua aqui</span>
        <h1>Entre no <em>Nexus.</em></h1>
        <p>Acesse seu perfil e acompanhe sua trajetória na comunidade.</p>
    </div>

    <div class="account-card">
        <div class="account-card-heading">
            <span class="account-step">Acesso</span>
            <h2>Boas-vindas de volta</h2>
            <p>Entre com sua conta Google para acessar o Age Nexus.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="form-alert form-alert-error" role="alert">@ErrorMessage</div>
        }

        <GoogleSignIn ReturnUrl="@SafeReturnUrl" />
        <p class="account-switch">Seu e-mail não será exibido no perfil público.</p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "erro")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string SafeReturnUrl => IsSafeLocalUrl(ReturnUrl) ? ReturnUrl! : "/";

    private string? ErrorMessage => Error switch
    {
        "bloqueado" => "Esta conta está temporariamente bloqueada. Tente novamente mais tarde.",
        "google" => "Não foi possível concluir a entrada com o Google.",
        "google-vinculacao" => "Esta conta preexistente precisa ser vinculada ao Google pelo administrador.",
        "google-indisponivel" => "A autenticação do Google ainda não está configurada.",
        "acesso-restrito" => "Esta instalação aceita somente a conta administradora já cadastrada.",
        _ => null
    };

    private static bool IsSafeLocalUrl(string? value) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.StartsWith('/') &&
        !value.StartsWith("//", StringComparison.Ordinal) &&
        !value.StartsWith("/\\", StringComparison.Ordinal);
}
