@page "/jogadores"
@inject AgeNexus.Application.Queries.IPlayerDirectoryQueryService Directory

<PageTitle>Jogadores · Age Nexus</PageTitle>

<section class="page-heading compact-heading">
    <div><span class="eyebrow">Guerreiros do Nexus</span><h1>Jogadores</h1><p>Perfis, ratings e evolução em cada modalidade.</p></div>
    <AuthorizeView Policy="Administrator">
        <Authorized>
            <a class="button button-primary" href="/jogadores/gerenciar"><span>+</span> Gerenciar participantes</a>
        </Authorized>
    </AuthorizeView>
</section>

@if (PlayerItems.Count == 0)
{
    <section class="panel panel-empty page-empty">
        <span class="empty-icon">♙</span><strong>Nenhum jogador cadastrado</strong>
    </section>
}
else
{
    <section class="card-grid">
        @foreach (var player in VisiblePlayers)
        {
            <a class="panel quick-card player-directory-card" href="/jogadores/@player.PlayerId">
                <PlayerAvatar DisplayName="@player.DisplayName" Url="@player.AvatarUrl" Size="directory" />
                <div>
                    <strong>@player.DisplayName</strong>
                    <small>Rating @player.CompetitiveRating.ToString("0") · Carreira @player.CareerPoints.ToString("0.##") · IA @player.PvePoints.ToString("0.##")</small>
                </div>
                <b>→</b>
            </a>
        }
    </section>
    <PaginationNav CurrentPage="@CurrentPage" TotalItems="@PlayerItems.Count" PageSize="@PageSize" BasePath="/jogadores" />
}

@code {
    private const int PageSize = 12;
    [SupplyParameterFromQuery(Name = "pagina")] private int Page { get; set; } = 1;
    private IReadOnlyCollection<AgeNexus.Application.Queries.PlayerSummary> PlayerItems { get; set; } = [];
    private int CurrentPage => Math.Clamp(Page, 1, Math.Max(1, (int)Math.Ceiling(PlayerItems.Count / (double)PageSize)));
    private IEnumerable<AgeNexus.Application.Queries.PlayerSummary> VisiblePlayers =>
        PlayerItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnParametersSetAsync() => PlayerItems = await Directory.GetAsync(500);
}
