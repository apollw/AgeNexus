@page "/estatisticas/gerais"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AgeNexus.Application.Queries.IGeneralStatisticsQueryService Statistics

<PageTitle>Estatísticas gerais · Age Nexus</PageTitle>

<LoadingOverlay Visible="@IsLoading" Message="Consultando os recordes..." />

<section class="page-heading records-page-heading">
    <div>
        <span class="eyebrow">Crônicas do Nexus</span>
        <h1>Hall dos <em>recordes.</em></h1>
        <p>As grandes marcas de combate, economia e evolução construídas em todas as partidas validadas.</p>
    </div>
    @if (Dashboard is not null)
    {
        <div class="records-seal" aria-label="@Dashboard.Boards.Count recordes acompanhados">
            <span>Recordes</span>
            <strong>@Dashboard.Boards.Count</strong>
            <small>monitorados</small>
        </div>
    }
</section>

@if (Dashboard is null)
{
    <section class="panel panel-empty page-empty"><strong>Consultando as crônicas...</strong></section>
}
else if (Dashboard.MatchesWithStatistics == 0)
{
    <section class="panel panel-empty page-empty">
        <span class="empty-icon">◇</span>
        <strong>O salão ainda está vazio</strong>
        <p>Preencha e aplique as estatísticas de uma partida para inaugurar os recordes.</p>
    </section>
}
else
{
    <section class="records-hero">
        <div class="records-hero-main">
            <span class="records-hero-label">Maior detentor de recordes</span>
            @if (OverallLeaders.FirstOrDefault() is { } master)
            {
                <div class="records-master">
                    <PlayerAvatar DisplayName="@master.DisplayName" Url="@master.AvatarUrl" Size="hero"
                                  Class="records-master-avatar" Lazy="false" />
                    <div>
                        <h2>@master.DisplayName</h2>
                        <p>Ocupa o primeiro lugar em <strong>@master.FirstPlaces</strong> recordes positivos.</p>
                    </div>
                </div>
            }
            <div class="records-hero-rule"><span></span><b>AGE NEXUS</b><span></span></div>
            <div class="records-podium">
                @foreach (var leader in OverallLeaders.Take(3))
                {
                    <div class="records-podium-place records-podium-@leader.Position">
                        <span>@Roman(leader.Position)</span>
                        <PlayerAvatar DisplayName="@leader.DisplayName" Url="@leader.AvatarUrl" Size="compact" />
                        <div><strong>@leader.DisplayName</strong><small>@leader.FirstPlaces liderança(s) positiva(s)</small></div>
                    </div>
                }
            </div>
        </div>

        <aside class="records-ledger">
            <span class="eyebrow">Livro da temporada</span>
            <div><strong>@Dashboard.MatchesWithStatistics</strong><span>Partidas analisadas</span></div>
            <div><strong>@Dashboard.PlayersWithStatistics</strong><span>Jogadores presentes</span></div>
            <div><strong>@Dashboard.StatisticRows</strong><span>Desempenhos registrados</span></div>
            <a href="/partidas">Consultar partidas <span>→</span></a>
        </aside>
    </section>

    <section class="records-feature-strip" aria-label="Recordes em destaque">
        @foreach (var board in FeaturedBoards)
        {
            var champion = board.Entries.First();
            <button type="button" class="records-feature" title="@board.Description" @onclick="() => SelectCategory(board.Category, false)">
                <span class="records-feature-mark">@ShortMark(board.Key)</span>
                <div><small>@board.Title</small><strong>@champion.DisplayName</strong></div>
                <b>@FormatValue(champion.Value, board.ValueKind)</b>
            </button>
        }
    </section>

    <div class="record-kind-tabs records-kind-tabs" role="tablist" aria-label="Tipos de recordes gerais">
        <button class="record-kind-positive @(!ShowNegativeRecords ? "active" : null)" type="button"
                role="tab" aria-selected="@(!ShowNegativeRecords)" @onclick="() => SelectRecordKind(false)">
            <span>✦</span><strong>Marcas positivas</strong><small>@PositiveRecordCount conquistas monitoradas</small>
        </button>
        <button class="record-kind-negative @(ShowNegativeRecords ? "active" : null)" type="button"
                role="tab" aria-selected="@ShowNegativeRecords" @onclick="() => SelectRecordKind(true)">
            <span>↓</span><strong>Marcas negativas</strong><small>@NegativeRecordCount marcas inglórias monitoradas</small>
        </button>
    </div>

    <nav class="records-category-nav" aria-label="Categorias dos recordes">
        <span>Categoria</span>
        @foreach (var category in ActiveCategories)
        {
            <button class="@(SelectedCategory == category ? "active" : null)" type="button"
                    aria-expanded="@(SelectedCategory == category)"
                    @onclick="() => SelectCategory(category, ShowNegativeRecords)"><b>@CategoryNumber(category)</b>@category</button>
        }
    </nav>

    @if (SelectedCategory is null)
    {
        <section class="records-category-prompt">
            <span>◇</span>
            <div>
                <strong>Abra uma categoria para consultar seus recordes</strong>
                <p>Somente a categoria escolhida será exibida. Ao voltar a ela, o conteúdo já estará pronto na memória.</p>
            </div>
        </section>
    }
    else
    {
        var category = SelectedCategory!;
        var categoryBoards = ActiveCategoryBoards;
        <section class="records-category records-category-@CategoryClass(category)" id="@CategoryId(category)">
            <header class="records-category-heading">
                <div class="records-category-number">@CategoryNumber(category)</div>
                <div>
                    <span class="eyebrow">Domínio</span>
                    <h2>@category</h2>
                    <p>@CategoryDescription(category)</p>
                </div>
                <span class="records-category-count">@categoryBoards.Length marcas</span>
            </header>

            @if (CategoryCache.ContainsKey(CategoryCacheKey(category, ShowNegativeRecords)))
            {
                <div class="records-board-grid">
                    @foreach (var indexed in categoryBoards.Select((board, index) => new { Board = board, Index = index + 1 }))
                    {
                        var board = indexed.Board;
                        <article class="record-board @(board.IsNegative ? "record-board-negative" : null)">
                            <header class="record-board-heading">
                                <span>@indexed.Index.ToString("00")</span>
                                <div><h3>@board.Title</h3><p>@board.Description</p></div>
                            </header>

                            @if (board.Entries.Count == 0)
                            {
                                <div class="record-board-empty">Aguardando dados</div>
                            }
                            else
                            {
                                var champion = board.Entries.First();
                                <div class="record-board-champion">
                                    <span class="record-crown">♛</span>
                                    <PlayerAvatar DisplayName="@champion.DisplayName" Url="@champion.AvatarUrl" Size="list"
                                                  Class="record-avatar" />
                                    <div>
                                        <small>@(board.IsNegative ? "Marca inglória" : "Recordista atual")</small>
                                        <strong>@champion.DisplayName</strong>
                                        <span>@champion.Matches partida(s) contabilizada(s)</span>
                                        <span class="record-entry-details">@EntryDetails(champion, board)</span>
                                    </div>
                                    <b>@FormatValue(champion.Value, board.ValueKind)</b>
                                </div>

                                @if (board.Entries.Count > 1)
                                {
                                    <ol class="record-board-ranking">
                                        @foreach (var entry in board.Entries.Skip(1))
                                        {
                                            <li>
                                                <span>@entry.Position</span>
                                                <PlayerAvatar DisplayName="@entry.DisplayName" Url="@entry.AvatarUrl" Size="compact" />
                                                <strong>@entry.DisplayName</strong>
                                                <small>@entry.Matches jogo(s) · @EntryDetails(entry, board)</small>
                                                <b>@FormatValue(entry.Value, board.ValueKind)</b>
                                            </li>
                                        }
                                    </ol>
                                }
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
}

@code {
    private AgeNexus.Application.Queries.GeneralStatisticsDashboard? Dashboard { get; set; }
    private Dictionary<string, AgeNexus.Application.Queries.GeneralStatisticBoard[]> CategoryCache { get; } = [];
    private bool IsLoading { get; set; } = true;
    private bool ShowNegativeRecords { get; set; }
    private string? SelectedCategory { get; set; }

    private IReadOnlyCollection<string> ActiveCategories => Dashboard?.Boards
        .Where(board => board.IsNegative == ShowNegativeRecords)
        .Select(board => board.Category).Distinct().ToArray() ?? [];
    private AgeNexus.Application.Queries.GeneralStatisticBoard[] ActiveCategoryBoards => SelectedCategory is not null &&
        CategoryCache.TryGetValue(CategoryCacheKey(SelectedCategory, ShowNegativeRecords), out var boards) ? boards : [];
    private int PositiveRecordCount => Dashboard?.Boards.Count(board => !board.IsNegative) ?? 0;
    private int NegativeRecordCount => Dashboard?.Boards.Count(board => board.IsNegative) ?? 0;

    private IReadOnlyCollection<RecordLeader> OverallLeaders => Dashboard?.Boards
        .Where(x => !x.IsNegative && x.Entries.Count > 0)
        .Select(x => x.Entries.First())
        .GroupBy(x => new { x.PlayerId, x.DisplayName, x.AvatarUrl })
        .Select(x => new { x.Key.PlayerId, x.Key.DisplayName, x.Key.AvatarUrl, FirstPlaces = x.Count() })
        .OrderByDescending(x => x.FirstPlaces)
        .ThenBy(x => x.DisplayName)
        .Take(3)
        .Select((x, index) => new RecordLeader(index + 1, x.PlayerId, x.DisplayName, x.AvatarUrl, x.FirstPlaces))
        .ToArray() ?? [];

    private IReadOnlyCollection<AgeNexus.Application.Queries.GeneralStatisticBoard> FeaturedBoards =>
        Dashboard?.Boards.Where(x => x.Entries.Count > 0 &&
            new[] { "units-killed", "gold", "fastest-feudal", "total-score" }.Contains(x.Key)).ToArray() ?? [];

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            Dashboard = await Statistics.GetAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectRecordKind(bool negative)
    {
        ShowNegativeRecords = negative;
        SelectedCategory = null;
    }

    private void SelectCategory(string category, bool negative)
    {
        if (ShowNegativeRecords == negative && SelectedCategory == category)
        {
            SelectedCategory = null;
            return;
        }

        ShowNegativeRecords = negative;
        SelectedCategory = category;
        var cacheKey = CategoryCacheKey(category, negative);
        if (!CategoryCache.ContainsKey(cacheKey))
        {
            CategoryCache[cacheKey] = Dashboard?.Boards
                .Where(board => board.Category == category && board.IsNegative == negative)
                .ToArray() ?? [];
        }
    }

    private static string CategoryCacheKey(string category, bool negative) => $"{(negative ? "negative" : "positive")}:{category}";

    private static string FormatValue(decimal value, AgeNexus.Application.Queries.GeneralStatisticValueKind kind) => kind switch
    {
        AgeNexus.Application.Queries.GeneralStatisticValueKind.Percentage => $"{value:0.##}%",
        AgeNexus.Application.Queries.GeneralStatisticValueKind.Duration => FormatDuration(value),
        AgeNexus.Application.Queries.GeneralStatisticValueKind.Decimal => value.ToString("N1"),
        _ => value.ToString("N0")
    };

    private static string FormatDuration(decimal value)
    {
        var seconds = Math.Max(0, decimal.ToInt32(decimal.Truncate(value)));
        return $"{seconds / 3600:00}:{seconds % 3600 / 60:00}:{seconds % 60:00}";
    }

    private static string EntryDetails(
        AgeNexus.Application.Queries.GeneralStatisticEntry entry,
        AgeNexus.Application.Queries.GeneralStatisticBoard board)
    {
        var absolute = entry.AbsoluteValue.HasValue
            ? $"{board.AbsoluteLabel}: {FormatValue(entry.AbsoluteValue.Value, board.ValueKind)}"
            : null;
        var average = entry.AverageValue.HasValue
            ? $"{board.AverageLabel}: {FormatValue(entry.AverageValue.Value, board.AverageValueKind ?? board.ValueKind)}"
            : null;
        return string.Join(" · ", new[] { absolute, average }.Where(value => value is not null));
    }

    private static string CategoryId(string category) => $"categoria-{CategoryClass(category)}";
    private static string CategoryClass(string category) => category.ToLowerInvariant() switch
    {
        "combate" => "combat",
        "economia" => "economy",
        "tecnologia" => "technology",
        "sociedade" => "society",
        "resultados" => "results",
        _ => "score"
    };

    private static string CategoryNumber(string category) => category.ToLowerInvariant() switch
    {
        "combate" => "I",
        "economia" => "II",
        "tecnologia" => "III",
        "sociedade" => "IV",
        "resultados" => "R",
        _ => "V"
    };

    private static string CategoryDescription(string category) => category switch
    {
        "Combate" => "Força militar, perdas e domínio sobre o campo de batalha.",
        "Economia" => "A abundância que sustentou exércitos, muralhas e impérios.",
        "Tecnologia" => "Velocidade de evolução, conhecimento e visão do mapa.",
        "Sociedade" => "O legado construído em população, monumentos e relíquias.",
        "Resultados" => "Derrotas acumuladas e frequência de resultados negativos.",
        _ => "A consistência refletida nos placares finais de cada confronto."
    };

    private static string ShortMark(string key) => key switch
    {
        "units-killed" => "K",
        "gold" => "Au",
        "fastest-feudal" => "F",
        "total-score" => "Σ",
        _ => "•"
    };

    private static string Roman(int value) => value switch { 1 => "I", 2 => "II", _ => "III" };

    private sealed record RecordLeader(
        int Position,
        Guid PlayerId,
        string DisplayName,
        string? AvatarUrl,
        int FirstPlaces);
}
