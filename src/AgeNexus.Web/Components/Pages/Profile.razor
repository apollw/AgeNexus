@page "/perfil"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AgeNexus.Infrastructure.Identity.AccountService Accounts

<PageTitle>Meu perfil · Age Nexus</PageTitle>

<section class="profile-page">
    <div class="page-heading compact-heading">
        <div>
            <span class="eyebrow">Identidade de jogador</span>
            <h1>Seu perfil no <em>Nexus.</em></h1>
            <p>Escolha como os outros jogadores enxergam você. O e-mail da conta permanece privado.</p>
        </div>
    </div>

    @if (CurrentProfile is null)
    {
        <div class="panel panel-empty">
            <strong>Sua conta ainda não está ligada a um jogador.</strong>
            <p>Escolha um nick histórico ou crie seu primeiro perfil.</p>
            <a class="button button-primary" href="/conta/vincular-perfil">Vincular meu jogador</a>
        </div>
    }
    else
    {
        <div class="profile-layout">
            <aside class="profile-preview panel">
                @if (!string.IsNullOrWhiteSpace(CurrentProfile.AvatarUrl))
                {
                    <img class="profile-avatar-image" src="@CurrentProfile.AvatarUrl" alt="Avatar de @CurrentProfile.DisplayName" />
                }
                else
                {
                    <span class="avatar avatar-xxl">@GetInitial(CurrentProfile.DisplayName)</span>
                }
                <span class="eyebrow">Prévia pública</span>
                <h2>@CurrentProfile.DisplayName</h2>
                @if (!string.IsNullOrWhiteSpace(CurrentProfile.FavoriteFactionName))
                {
                    <div class="profile-favorite-civ">
                        @if (!string.IsNullOrWhiteSpace(CurrentProfile.FavoriteFactionImageUrl))
                        {
                            <img src="@CurrentProfile.FavoriteFactionImageUrl" alt="" />
                        }
                        <span>Civilização favorita<br /><strong>@CurrentProfile.FavoriteFactionName</strong></span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(CurrentProfile.Location))
                {
                    <p class="profile-location">⌖ @CurrentProfile.Location</p>
                }
                <p>@(string.IsNullOrWhiteSpace(CurrentProfile.Bio) ? "Conte um pouco sobre sua jornada nos jogos." : CurrentProfile.Bio)</p>
                <div class="profile-avatar-actions">
                    <label class="button button-secondary button-compact profile-upload-button">
                        Trocar foto
                        <InputFile OnChange="UploadAvatarAsync" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" disabled="@Busy" />
                    </label>
                    @if (!string.IsNullOrWhiteSpace(CurrentProfile.AvatarUrl))
                    {
                        <button class="table-action-button table-action-danger" type="button" @onclick="RemoveAvatarAsync" disabled="@Busy">Remover foto</button>
                    }
                </div>
                <small class="profile-avatar-help">JPEG, PNG ou WebP · até 2 MB</small>
                <a class="profile-public-link" href="/jogadores/@CurrentProfile.Id">Ver meu perfil público →</a>
            </aside>

            <div class="account-card profile-form-card">
                <div class="account-card-heading">
                    <span class="account-step">Personalização</span>
                    <h2>Informações públicas</h2>
                    <p>Todos estes campos podem ser alterados novamente.</p>
                </div>

                @if (Saved == "1")
                {
                    <div class="form-alert form-alert-success" role="status">Perfil atualizado com sucesso.</div>
                }
                else if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="form-alert form-alert-error" role="alert">@(Error == "nick-em-uso" ? "Esse nick já pertence a outro jogador." : "Revise os dados do perfil.")</div>
                }
                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="form-alert @(HasError ? "form-alert-error" : "form-alert-success")" role="status">@Message</div>
                }

                <form method="post" action="/account/profile" class="account-form">
                    <AntiforgeryToken />

                    <label class="form-field">
                        <span>Nome público</span>
                        <input name="displayName" required maxlength="100" value="@CurrentProfile.DisplayName" />
                    </label>

                    <label class="form-field">
                        <span>Localização</span>
                        <input name="location" maxlength="100" value="@CurrentProfile.Location" placeholder="Ex.: Fortaleza, CE" />
                    </label>

                    <label class="form-field">
                        <span>Civilização favorita</span>
                        <select name="favoriteFactionId">
                            <option value="">Ainda não escolhi</option>
                            @foreach (var faction in Factions)
                            {
                                <option value="@faction.Id" selected="@(CurrentProfile.FavoriteFactionId == faction.Id)">@faction.Name</option>
                            }
                        </select>
                    </label>

                    <label class="form-field">
                        <span>Sobre você</span>
                        <textarea name="bio" maxlength="500" rows="5" placeholder="Jogos favoritos, estilo de jogo, grupos...">@CurrentProfile.Bio</textarea>
                        <small>Até 500 caracteres.</small>
                    </label>

                    <button class="button button-primary account-submit" type="submit">Salvar perfil</button>
                </form>
            </div>
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "salvo")]
    private string? Saved { get; set; }

    [SupplyParameterFromQuery(Name = "erro")]
    private string? Error { get; set; }

    private AgeNexus.Infrastructure.Identity.PublicProfile? CurrentProfile { get; set; }
    private IReadOnlyCollection<AgeNexus.Infrastructure.Identity.ProfileFactionOption> Factions { get; set; } = [];
    private string? Message { get; set; }
    private bool HasError { get; set; }
    private bool Busy { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        CurrentProfile = await Accounts.GetProfileAsync(authenticationState.User, CancellationToken.None);
        Factions = await Accounts.GetFactionOptionsAsync();
    }

    private async Task UploadAvatarAsync(InputFileChangeEventArgs args)
    {
        Busy = true;
        Message = null;
        try
        {
            await using var input = args.File.OpenReadStream(2 * 1024 * 1024);
            using var memory = new MemoryStream();
            await input.CopyToAsync(memory);
            var authentication = await AuthenticationStateTask;
            var result = await Accounts.UploadProfileAvatarAsync(
                authentication.User, args.File.Name, memory.ToArray());
            SetAvatarResult(result, "Foto atualizada.");
            CurrentProfile = await Accounts.GetProfileAsync(authentication.User, CancellationToken.None);
        }
        catch (IOException)
        {
            HasError = true;
            Message = "A imagem deve ter no máximo 2 MB.";
        }
        Busy = false;
    }

    private async Task RemoveAvatarAsync()
    {
        Busy = true;
        var authentication = await AuthenticationStateTask;
        var result = await Accounts.RemoveProfileAvatarAsync(authentication.User);
        SetAvatarResult(result, "Foto removida.");
        CurrentProfile = await Accounts.GetProfileAsync(authentication.User, CancellationToken.None);
        Busy = false;
    }

    private void SetAvatarResult(AgeNexus.Infrastructure.Identity.AccountOperationResult result, string success)
    {
        HasError = !result.Succeeded;
        Message = result.Succeeded ? success : result.ErrorCodes.FirstOrDefault() switch
        {
            "InvalidAvatar" => "Use uma imagem JPEG, PNG ou WebP válida, com até 2 MB.",
            "AvatarStorageNotConfigured" => "O armazenamento de imagens ainda não está configurado.",
            _ => "Não foi possível atualizar a foto agora."
        };
    }

    private static string GetInitial(string value) => value[..1].ToUpperInvariant();
}
