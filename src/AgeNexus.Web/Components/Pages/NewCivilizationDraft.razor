@page "/partidas/drafts/novo"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AgeNexus.Application.Drafts.ICivilizationDraftService Drafts
@inject AgeNexus.Application.Queries.ICatalogQueryService CatalogQueries
@inject AgeNexus.Infrastructure.Identity.AccountService Accounts
@inject NavigationManager Navigation

<PageTitle>Novo draft · Age Nexus</PageTitle>
<LoadingOverlay Visible="@Loading" Message="Preparando o draft..." />

<section class="page-heading compact-heading">
    <div><span class="eyebrow">Sala compartilhada</span><h1>Draft de civilizações</h1><p>Monte os times e crie a sala. Isso não registra uma partida.</p></div>
    <a class="button button-secondary" href="/partidas">Voltar</a>
</section>

@if (Catalog is not null)
{
    <section class="panel draft-create-panel">
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="form-alert form-alert-error">@Error</div>
        }
        <div class="draft-create-grid">
            <label class="form-field"><span>Nome do draft</span><input @bind="Title" maxlength="120" placeholder="Ex.: Regicídio de sexta" /></label>
            <label class="form-field"><span>Edição</span><select @bind="EditionId" @bind:after="EditionChangedAsync">@foreach (var item in Catalog.GameEditions) { <option value="@item.Id">@item.Name</option> }</select></label>
            <label class="form-field"><span>Mapa</span><select @bind="MapId"><option value="">A definir</option>@foreach (var item in Catalog.Maps) { <option value="@item.Id">@item.Name</option> }</select></label>
            <label class="form-field"><span>Tipo de jogo</span><select @bind="GameMode">@foreach (var mode in Enum.GetValues<AgeNexus.Domain.Matches.MatchGameMode>()) { <option value="@mode">@ModeLabel(mode)</option> }</select></label>
        </div>

        <div class="draft-team-editor">
            @foreach (var team in Teams)
            {
                <article class="draft-team-edit-card">
                    <header><input @bind="team.Name" maxlength="40" aria-label="Nome do time" /><button type="button" class="table-action-button table-action-danger" @onclick="() => RemoveTeam(team)" disabled="@(Teams.Count <= 2)">Remover</button></header>
                    @foreach (var slot in team.Players)
                    {
                        <div class="draft-player-select"><select @bind="slot.PlayerId"><option value="">Selecione um jogador</option>@foreach (var player in AvailablePlayers(slot.PlayerId)) { <option value="@player.Id">@player.Name</option> }</select><button type="button" @onclick="() => team.Players.Remove(slot)" disabled="@(team.Players.Count <= 1)" aria-label="Remover jogador">×</button></div>
                    }
                    <button type="button" class="table-action-button" @onclick="() => AddPlayer(team)" disabled="@(TotalPlayers >= 8)">+ Jogador</button>
                </article>
            }
        </div>
        <div class="draft-create-actions">
            <button type="button" class="button button-secondary" @onclick="AddTeam" disabled="@(Teams.Count >= 8 || TotalPlayers >= 8)">+ Time</button>
            <span>@TotalPlayers de 8 jogadores</span>
            <button type="button" class="button button-primary" @onclick="CreateAsync" disabled="@Saving">@(Saving ? "Criando sala..." : "Criar sala compartilhável")</button>
        </div>
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private AgeNexus.Application.Queries.MatchRegistrationCatalog? Catalog;
    private AgeNexus.Infrastructure.Identity.PublicProfile? Profile;
    private readonly List<TeamForm> Teams = [new("Time 1"), new("Time 2")];
    private string Title = "Draft de civilizações";
    private Guid EditionId;
    private Guid? MapId;
    private AgeNexus.Domain.Matches.MatchGameMode GameMode = AgeNexus.Domain.Matches.MatchGameMode.Standard;
    private bool Loading = true;
    private bool Saving;
    private string? Error;
    private int TotalPlayers => Teams.Sum(x => x.Players.Count);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateTask;
        Profile = await Accounts.GetProfileAsync(auth.User, CancellationToken.None);
        Catalog = await CatalogQueries.GetMatchRegistrationCatalogAsync();
        EditionId = Catalog.GameEditions.FirstOrDefault()?.Id ?? Guid.Empty;
        foreach (var team in Teams) team.Players.Add(new());
        Loading = false;
    }

    private IEnumerable<AgeNexus.Application.Queries.CatalogOption> AvailablePlayers(Guid? current) =>
        Catalog!.Players.Where(x => x.Id == current || !Teams.SelectMany(t => t.Players).Any(p => p.PlayerId == x.Id));
    private void AddTeam() { var team = new TeamForm($"Time {Teams.Count + 1}"); team.Players.Add(new()); Teams.Add(team); }
    private void RemoveTeam(TeamForm team) { if (Teams.Count > 2) Teams.Remove(team); }
    private void AddPlayer(TeamForm team) { if (TotalPlayers < 8) team.Players.Add(new()); }
    private async Task EditionChangedAsync() { Catalog = await CatalogQueries.GetMatchRegistrationCatalogAsync(EditionId); MapId = null; }

    private async Task CreateAsync()
    {
        Error = null;
        if (Profile is null) { Error = "Conclua seu perfil antes de criar um draft."; return; }
        var playerIds = Teams.SelectMany(x => x.Players).Select(x => x.PlayerId).ToArray();
        if (playerIds.Any(x => !x.HasValue) || playerIds.Distinct().Count() != playerIds.Length) { Error = "Selecione jogadores diferentes em todos os espaços."; return; }
        Saving = true;
        var request = new AgeNexus.Application.Drafts.CreateCivilizationDraftRequest(Title, EditionId, MapId, GameMode,
            Teams.Select(x => new AgeNexus.Application.Drafts.CivilizationDraftTeamInput(x.Name, x.Players.Select(p => p.PlayerId!.Value).ToArray())).ToArray());
        var result = await Drafts.CreateAsync(Profile.Id, request);
        Saving = false;
        if (result.Succeeded) Navigation.NavigateTo($"/partidas/drafts/{result.ShareCode}");
        else Error = result.ErrorCode switch { "InsufficientFactions" => "O catálogo não possui civilizações suficientes.", "InvalidCatalog" => "Mapa, edição ou jogador inválido.", _ => "Revise o nome, os times e os jogadores." };
    }

    private static string ModeLabel(AgeNexus.Domain.Matches.MatchGameMode mode) => mode switch
    {
        AgeNexus.Domain.Matches.MatchGameMode.Conquest => "Conquista", AgeNexus.Domain.Matches.MatchGameMode.Regicide => "Regicídio",
        AgeNexus.Domain.Matches.MatchGameMode.KingOfTheHill => "Rei da Colina", AgeNexus.Domain.Matches.MatchGameMode.WonderRace => "Corrida das Maravilhas",
        AgeNexus.Domain.Matches.MatchGameMode.DefendTheWonder => "Defender a Maravilha", AgeNexus.Domain.Matches.MatchGameMode.CaptureTheRelic => "Capturar a Relíquia",
        AgeNexus.Domain.Matches.MatchGameMode.SuddenDeath => "Morte Súbita", AgeNexus.Domain.Matches.MatchGameMode.DeathMatch => "Combate Mortal",
        AgeNexus.Domain.Matches.MatchGameMode.EmpireWars => "Guerras de Impérios", AgeNexus.Domain.Matches.MatchGameMode.BattleRoyale => "Battle Royale",
        AgeNexus.Domain.Matches.MatchGameMode.Other => "Outro", _ => "Padrão"
    };
    private sealed class TeamForm(string name) { public string Name { get; set; } = name; public List<PlayerSlot> Players { get; } = []; }
    private sealed class PlayerSlot { public Guid? PlayerId { get; set; } }
}
