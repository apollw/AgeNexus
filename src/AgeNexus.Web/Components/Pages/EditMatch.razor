@page "/partidas/{MatchId:guid}/editar"
@attribute [Authorize(Policy = "Administrator")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AgeNexus.Application.Matches.IMatchWorkflowService Workflow
@inject AgeNexus.Application.Queries.IMatchHistoryQueryService History
@inject AgeNexus.Application.Queries.ICatalogQueryService CatalogQueries
@inject AgeNexus.Infrastructure.Identity.AccountService Accounts
@inject NavigationManager Navigation

<PageTitle>Editar partida · Age Nexus</PageTitle>
<LoadingOverlay Visible="@(Loading || Saving)" Message="@(Saving ? "Salvando alterações..." : "Carregando partida...")" />

<section class="page-heading compact-heading">
    <div><span class="eyebrow">Ajustes da batalha</span><h1>Editar partida</h1><p>Atualize mapa, modalidade e associação de clãs.</p></div>
    <a class="button button-secondary" href="/partidas/@MatchId">Cancelar</a>
</section>

@if (!Loading && View is null)
{
    <section class="panel panel-empty page-empty"><strong>Partida não encontrada</strong></section>
}
else if (View is not null)
{
    <EditForm Model="Form" OnValidSubmit="SaveAsync" class="account-form">
        <section class="panel profile-form-card">
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="form-alert form-alert-error">@Error</div>
            }
            <div class="form-grid">
                <label class="form-field"><span>Edição</span><input value="@View.GameEditionName" disabled /></label>
                <label class="form-field"><span>Mapa</span>
                    <InputSelect @bind-Value="Form.MapDefinitionId">
                        <option value="">Não informado</option>
                        @foreach (var map in Maps) { <option value="@map.Id">@map.Name</option> }
                    </InputSelect>
                </label>
                <label class="form-field"><span>Tipo de partida</span>
                    <InputSelect @bind-Value="Form.GameMode">
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.Standard">Padrão</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.Conquest">Conquista</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.Regicide">Regicídio</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.KingOfTheHill">Rei da Colina</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.WonderRace">Corrida das Maravilhas</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.DefendTheWonder">Defender a Maravilha</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.CaptureTheRelic">Capturar a Relíquia</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.SuddenDeath">Morte Súbita</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.DeathMatch">Combate Mortal</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.EmpireWars">Guerras de Impérios</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.BattleRoyale">Battle Royale</option>
                        <option value="@AgeNexus.Domain.Matches.MatchGameMode.Other">Outro</option>
                    </InputSelect>
                </label>
            </div>
        </section>

        <section class="panel clan-match-setup edit-clan-match-setup">
            <label class="clan-match-toggle">
                <InputCheckbox @bind-Value="Form.IsClanMatch" @bind-Value:after="ClanMatchChanged"
                               disabled="@(Form.Teams.Count != 2 || Clans.Count < 2)" />
                <span>
                    <strong>Esta é uma partida entre clãs</strong>
                    <small>@(Clans.Count < 2 ? "É necessário ter pelo menos dois clãs cadastrados." : "Associe cada equipe ao clã que ela representou nesta partida.")</small>
                </span>
            </label>

            @if (Form.IsClanMatch)
            {
                <div class="edit-clan-team-grid">
                    @foreach (var team in Form.Teams.OrderBy(x => x.Position))
                    {
                        <article class="match-clan-loader" @key="team.TeamId">
                            <label class="form-field"><span>Clã da equipe @team.Position</span>
                                <InputSelect @bind-Value="team.ClanId">
                                    <option value="">Selecione o clã</option>
                                    @foreach (var clan in Clans) { <option value="@clan.ClanId">[@clan.Tag] @clan.Name</option> }
                                </InputSelect>
                            </label>
                            <div class="clan-lineup-hint"><strong>Jogadores registrados</strong><span>@string.Join(", ", team.Players.Select(x => x.DisplayName))</span></div>
                        </article>
                    }
                </div>
            }
        </section>
        <button class="button button-primary account-submit" type="submit" disabled="@Saving">Salvar alterações</button>
    </EditForm>
}

@code {
    [Parameter] public Guid MatchId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private AgeNexus.Application.Queries.MatchMetadataEditView? View { get; set; }
    private IReadOnlyCollection<AgeNexus.Application.Queries.CatalogOption> Maps { get; set; } = [];
    private IReadOnlyCollection<AgeNexus.Application.Queries.ClanSummary> Clans { get; set; } = [];
    private EditMatchForm Form { get; } = new();
    private bool Loading { get; set; } = true;
    private bool Saving { get; set; }
    private string? Error { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Loading = true;
        try
        {
            View = await History.GetMetadataForEditAsync(MatchId);
            if (View is null) return;

            var catalog = await CatalogQueries.GetMatchRegistrationCatalogAsync(View.GameEditionId);
            Maps = catalog.Maps;
            Clans = catalog.Clans;
            Form.MapDefinitionId = View.MapDefinitionId;
            Form.GameMode = View.GameMode;
            Form.Teams.Clear();
            Form.Teams.AddRange(View.Teams.Select(x => new EditMatchTeamForm
            {
                TeamId = x.TeamId,
                Position = x.Position,
                ClanId = x.ClanId,
                Players = x.Players
            }));
            Form.IsClanMatch = Form.Teams.Any(x => x.ClanId.HasValue);
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task SaveAsync()
    {
        var authentication = await AuthenticationStateTask;
        var profile = await Accounts.GetProfileAsync(authentication.User, CancellationToken.None);
        if (profile is null)
        {
            Error = "Não foi possível identificar seu perfil administrativo.";
            return;
        }

        Saving = true;
        Error = null;
        if (Form.IsClanMatch &&
            (Form.Teams.Any(x => !x.ClanId.HasValue) || Form.Teams.Select(x => x.ClanId).Distinct().Count() != 2))
        {
            Error = "Selecione dois clãs diferentes, um para cada equipe.";
            Saving = false;
            return;
        }
        try
        {
            var result = await Workflow.UpdateMetadataAsync(new(
                MatchId,
                profile.Id,
                Form.MapDefinitionId,
                Form.GameMode,
                Form.Teams.Select(x => new AgeNexus.Application.Matches.UpdateMatchTeamClan(
                    x.TeamId, Form.IsClanMatch ? x.ClanId : null)).ToArray()));
            if (result.Succeeded)
            {
                Navigation.NavigateTo($"/partidas/{MatchId}");
                return;
            }

            Error = result.ErrorCode switch
            {
                "InvalidMap" => "O mapa selecionado não pertence à edição desta partida.",
                "InvalidMatchState" => "Uma partida anulada não pode ser editada.",
                "NotAuthorized" => "Sua conta não possui permissão para editar esta partida.",
                "MatchNotFound" => "A partida não foi encontrada.",
                "InvalidClanMatch" => "Selecione dois clãs diferentes, um para cada equipe.",
                "InvalidClanLineup" => "Os jogadores de uma das equipes não pertenciam ao clã selecionado na data da partida.",
                _ => "Não foi possível salvar as alterações."
            };
        }
        finally
        {
            Saving = false;
        }
    }

    private sealed class EditMatchForm
    {
        public Guid? MapDefinitionId { get; set; }
        public AgeNexus.Domain.Matches.MatchGameMode GameMode { get; set; }
        public bool IsClanMatch { get; set; }
        public List<EditMatchTeamForm> Teams { get; } = [];
    }

    private sealed class EditMatchTeamForm
    {
        public Guid TeamId { get; set; }
        public int Position { get; set; }
        public Guid? ClanId { get; set; }
        public IReadOnlyCollection<AgeNexus.Application.Queries.MatchMetadataEditPlayer> Players { get; set; } = [];
    }

    private void ClanMatchChanged()
    {
        if (Form.IsClanMatch) return;
        foreach (var team in Form.Teams) team.ClanId = null;
    }
}
