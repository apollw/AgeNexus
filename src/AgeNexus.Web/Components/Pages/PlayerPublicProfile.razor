@page "/jogadores/{PlayerId:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AgeNexus.Application.Queries.IPlayerPublicProfileQueryService Profiles
@inject AgeNexus.Application.Queries.IGeneralStatisticsQueryService GeneralStatistics

<PageTitle>@(Profile is null ? "Jogador" : Profile.DisplayName) · Age Nexus</PageTitle>
<LoadingOverlay Visible="@(LoadingProfile || LoadingRecords)"
                Message="@(LoadingRecords ? "Consultando marcas pessoais..." : "Carregando perfil...")" />

@if (LoadingProfile)
{
    <section class="panel panel-empty page-empty"><strong>Carregando perfil...</strong></section>
}
else if (Profile is null)
{
    <section class="panel panel-empty page-empty"><strong>Jogador não encontrado.</strong><a class="button button-secondary" href="/jogadores">Voltar</a></section>
}
else
{
    <a class="public-profile-back" href="/jogadores">← Voltar aos jogadores</a>

    <section class="panel public-profile-hero">
        <div class="public-profile-identity">
            <PlayerAvatar DisplayName="@Profile.DisplayName" Url="@Profile.AvatarUrl" Size="profile"
                          Class="public-profile-avatar" Lazy="false" />
            <div>
                <span class="eyebrow">Guerreiro do Nexus</span>
                <h1>@Profile.DisplayName</h1>
                @if (!string.IsNullOrWhiteSpace(Profile.Location))
                {
                    <span class="public-profile-location">⌖ @Profile.Location</span>
                }
                <p>@(string.IsNullOrWhiteSpace(Profile.Bio) ? "Este jogador ainda não escreveu sua crônica." : Profile.Bio)</p>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Profile.FavoriteFactionName))
        {
            <aside class="public-profile-favorite">
                @if (!string.IsNullOrWhiteSpace(Profile.FavoriteFactionImageUrl))
                {
                    <img src="@Profile.FavoriteFactionImageUrl" alt="" />
                }
                <span>Civilização favorita<strong>@Profile.FavoriteFactionName</strong></span>
            </aside>
        }
    </section>

    <section class="public-profile-stats stat-grid">
        <article class="stat-card">
            <span class="stat-icon" aria-hidden="true">♜</span>
            <div><span>Rating competitivo</span><strong>@Profile.CompetitiveRating.ToString("N0")</strong><small>desempenho PvP</small></div>
        </article>
        <article class="stat-card">
            <span class="stat-icon" aria-hidden="true">✦</span>
            <div><span>Pontos de carreira</span><strong>@Profile.CareerPoints.ToString("N0")</strong><small>trajetória geral</small></div>
        </article>
        <article class="stat-card">
            <span class="stat-icon" aria-hidden="true">%</span>
            <div><span>Aproveitamento</span><strong>@Profile.WinRate.ToString("0.##")%</strong><small>@Profile.Victories V · @Profile.Draws E · @Profile.Defeats D</small></div>
        </article>
        <article class="stat-card">
            <span class="stat-icon" aria-hidden="true">⚔</span>
            <div><span>Partidas validadas</span><strong>@Profile.ValidatedMatches</strong><small>@Profile.PvePoints.ToString("N0") pontos contra IA</small></div>
        </article>
    </section>

    <div class="public-profile-grid">
        <section class="panel public-profile-section">
            <header class="panel-header">
                <div><span class="eyebrow">Marcas pessoais</span><h2>Recordes relevantes</h2></div>
                <span class="evidence-count">@(RecordsLoaded ? $"{Records.Count} marcas" : "Por categoria")</span>
            </header>

            <div class="record-kind-tabs" role="tablist" aria-label="Tipos de marcas pessoais">
                <button class="record-kind-positive @(!ShowNegativeRecords ? "active" : null)" type="button"
                        role="tab" aria-selected="@(!ShowNegativeRecords)" @onclick="() => SelectRecordKind(false)">
                    <span>✦</span><strong>Marcas positivas</strong><small>Conquistas e melhores desempenhos</small>
                </button>
                <button class="record-kind-negative @(ShowNegativeRecords ? "active" : null)" type="button"
                        role="tab" aria-selected="@ShowNegativeRecords" @onclick="() => SelectRecordKind(true)">
                    <span>↓</span><strong>Marcas negativas</strong><small>Perdas e marcas inglórias</small>
                </button>
            </div>

            <nav class="profile-record-categories" aria-label="Categorias das marcas pessoais">
                @foreach (var category in ActiveCategories)
                {
                    <button class="@(SelectedCategory == category ? "active" : null)" type="button"
                            aria-expanded="@(SelectedCategory == category)"
                            @onclick="() => LoadRecordCategoryAsync(category)">
                        @category
                    </button>
                }
            </nav>

            @if (SelectedCategory is null)
            {
                <div class="record-category-prompt">
                    <span>◇</span>
                    <div><strong>Escolha uma categoria</strong><p>As marcas serão carregadas somente quando você quiser consultá-las.</p></div>
                </div>
            }
            else if (!RecordCategoryCache.ContainsKey(RecordCategoryKey(SelectedCategory, ShowNegativeRecords)))
            {
                <div class="panel-empty"><p>Consultando marcas de @SelectedCategory.ToLowerInvariant()...</p></div>
            }
            else if (ActiveRecords.Count == 0)
            {
                <div class="panel-empty"><p>Nenhuma marca nesta categoria ainda.</p></div>
            }
            else
            {
                <div class="profile-record-list">
                    @foreach (var record in ActiveRecords)
                    {
                        <article class="profile-record @(record.IsNegative ? "profile-record-negative" : null)">
                            <span class="profile-record-rank">#@record.Position</span>
                            <div>
                                <strong>@record.Title</strong>
                                <p>@record.Description</p>
                                <small>@MatchCount(record.Matches) · @RecordDetails(record)</small>
                            </div>
                            <b>@FormatValue(record.Value, record.ValueKind)</b>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="panel public-profile-section">
            <header class="panel-header"><div><span class="eyebrow">Experiência militar</span><h2>Civilizações utilizadas</h2></div></header>
            @if (Profile.Factions.Count == 0)
            {
                <div class="panel-empty"><p>Nenhuma civilização registrada em partidas validadas.</p></div>
            }
            else
            {
                <div class="profile-faction-list">
                    @foreach (var faction in Profile.Factions.Take(8))
                    {
                        <article>
                            @if (!string.IsNullOrWhiteSpace(faction.ImageUrl))
                            {
                                <img src="@faction.ImageUrl" alt="" />
                            }
                            <div><strong>@faction.Name</strong><small>@UsageCount(faction.Uses) · @VictoryCount(faction.Victories)</small></div>
                            <b>@faction.WinRate.ToString("0.##")%</b>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public Guid PlayerId { get; set; }

    private AgeNexus.Application.Queries.PlayerPublicProfileDashboard? Profile { get; set; }
    private IReadOnlyCollection<PlayerRecord> Records { get; set; } = [];
    private Dictionary<string, PlayerRecord[]> RecordCategoryCache { get; } = [];
    private bool RecordsLoaded { get; set; }
    private bool LoadingProfile { get; set; } = true;
    private bool LoadingRecords { get; set; }
    private bool ShowNegativeRecords { get; set; }
    private string? SelectedCategory { get; set; }
    private static readonly string[] PositiveCategories = ["Combate", "Economia", "Tecnologia", "Sociedade", "Placar"];
    private static readonly string[] NegativeCategories = ["Resultados", "Combate", "Economia", "Tecnologia", "Sociedade", "Placar"];
    private IReadOnlyCollection<string> ActiveCategories => ShowNegativeRecords ? NegativeCategories : PositiveCategories;
    private IReadOnlyCollection<PlayerRecord> ActiveRecords => SelectedCategory is not null &&
        RecordCategoryCache.TryGetValue(RecordCategoryKey(SelectedCategory, ShowNegativeRecords), out var records) ? records : [];

    protected override async Task OnParametersSetAsync()
    {
        LoadingProfile = true;
        try
        {
            Profile = await Profiles.GetAsync(PlayerId);
            Records = [];
            RecordsLoaded = false;
            RecordCategoryCache.Clear();
            ShowNegativeRecords = false;
            SelectedCategory = null;
        }
        finally
        {
            LoadingProfile = false;
        }
    }

    private void SelectRecordKind(bool negative)
    {
        ShowNegativeRecords = negative;
        SelectedCategory = null;
    }

    private async Task LoadRecordCategoryAsync(string category)
    {
        if (SelectedCategory == category)
        {
            SelectedCategory = null;
            return;
        }

        SelectedCategory = category;
        var negative = ShowNegativeRecords;
        var categoryKey = RecordCategoryKey(category, negative);
        if (RecordCategoryCache.ContainsKey(categoryKey)) return;

        LoadingRecords = true;
        try
        {
            if (!RecordsLoaded)
            {
                var dashboard = await GeneralStatistics.GetAsync(5);
                Records = dashboard.Boards.SelectMany(board => board.Entries
                .Where(entry => entry.PlayerId == PlayerId)
                .Select(entry => new PlayerRecord(
                    board.Category, board.Title, board.Description, entry.Position, entry.Value, entry.Matches,
                    board.ValueKind, entry.AbsoluteValue, entry.AverageValue,
                    board.AverageValueKind ?? board.ValueKind, board.AbsoluteLabel, board.AverageLabel,
                    board.IsNegative)))
                    .ToArray();
                RecordsLoaded = true;
            }

            RecordCategoryCache[categoryKey] = Records
                .Where(record => record.IsNegative == negative && record.Category == category)
                .OrderBy(record => record.Position).ThenBy(record => record.Title).ToArray();
        }
        finally
        {
            LoadingRecords = false;
        }
    }

    private static string RecordCategoryKey(string category, bool negative) => $"{(negative ? "negative" : "positive")}:{category}";

    private static string FormatValue(decimal value, AgeNexus.Application.Queries.GeneralStatisticValueKind kind) => kind switch
    {
        AgeNexus.Application.Queries.GeneralStatisticValueKind.Percentage => $"{value:0.##}%",
        AgeNexus.Application.Queries.GeneralStatisticValueKind.Duration => FormatDuration(value),
        AgeNexus.Application.Queries.GeneralStatisticValueKind.Decimal => value.ToString("N1"),
        _ => value.ToString("N0")
    };

    private static string FormatDuration(decimal value)
    {
        var seconds = Math.Max(0, decimal.ToInt32(decimal.Truncate(value)));
        return $"{seconds / 3600:00}:{seconds % 3600 / 60:00}:{seconds % 60:00}";
    }

    private static string MatchCount(int count) => $"{count} {(count == 1 ? "partida contabilizada" : "partidas contabilizadas")}";
    private static string RecordDetails(PlayerRecord record)
    {
        var absolute = record.AbsoluteValue.HasValue
            ? $"{record.AbsoluteLabel}: {FormatValue(record.AbsoluteValue.Value, record.ValueKind)}"
            : null;
        var average = record.AverageValue.HasValue
            ? $"{record.AverageLabel}: {FormatValue(record.AverageValue.Value, record.AverageValueKind)}"
            : null;
        return string.Join(" · ", new[] { absolute, average }.Where(value => value is not null));
    }
    private static string UsageCount(int count) => $"{count} {(count == 1 ? "uso" : "usos")}";
    private static string VictoryCount(int count) => $"{count} {(count == 1 ? "vitória" : "vitórias")}";

    private sealed record PlayerRecord(
        string Category,
        string Title,
        string Description,
        int Position,
        decimal Value,
        int Matches,
        AgeNexus.Application.Queries.GeneralStatisticValueKind ValueKind,
        decimal? AbsoluteValue,
        decimal? AverageValue,
        AgeNexus.Application.Queries.GeneralStatisticValueKind AverageValueKind,
        string AbsoluteLabel,
        string AverageLabel,
        bool IsNegative);
}
