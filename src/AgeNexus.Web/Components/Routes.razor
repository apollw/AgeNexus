<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Página não encontrada · Age Nexus</PageTitle>
            <LayoutView Layout="typeof(MainLayout)">
                <section class="empty-state">
                    <span class="eyebrow">Erro 404</span>
                    <h1>Esta trilha ainda não existe.</h1>
                    <p>Volte ao Nexus para continuar explorando a comunidade.</p>
                    <a class="button button-primary" href="/">Voltar ao início</a>
                </section>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

