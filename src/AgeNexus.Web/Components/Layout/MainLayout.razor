@inherits LayoutComponentBase
@inject AgeNexus.Infrastructure.Identity.AccountService Accounts

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="Age Nexus - início">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48" role="img">
                    <path d="M24 4 41 14v20L24 44 7 34V14L24 4Z" />
                    <path d="m16 31 8-16 8 16M19 26h10" />
                </svg>
            </span>
            <span><strong>AGE</strong><b>NEXUS</b></span>
        </a>

        <NavMenu />

    </aside>

    <div class="main-column">
        <header class="topbar">
            <div class="mobile-brand">AGE <span>NEXUS</span></div>
            <div class="topbar-actions">
                <button class="icon-button" type="button" title="Notificações" aria-label="Notificações">
                    <svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                </button>
                <AuthorizeView>
                    <Authorized Context="session">
                        <a class="profile-chip" href="/perfil">
                            <PlayerAvatar DisplayName="@(CurrentProfile?.DisplayName ?? session.User.Identity?.Name ?? "Conta")"
                                          Url="@(CurrentProfile?.AvatarUrl)" Size="list" Lazy="false" />
                            <span class="profile-copy"><strong>@(CurrentProfile?.DisplayName ?? session.User.Identity?.Name)</strong><small>Minha conta</small></span>
                        </a>
                        <form method="post" action="/account/logout" class="logout-form">
                            <AntiforgeryToken />
                            <button class="logout-button" type="submit" aria-label="Sair da conta" title="Sair da conta">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M10 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h5M15 8l4 4-4 4M19 12H9" />
                                </svg>
                                <span>Sair</span>
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="topbar-link" href="/conta/login">Entrar</a>
                        <a class="button button-primary button-compact" href="/conta/criar">Criar conta</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="content">
            @Body
        </main>

        <footer class="site-footer">
            Age of Empires II © Microsoft Corporation. AgeNexus was created under Microsoft's
            <a href="https://www.xbox.com/en-US/developers/rules" target="_blank" rel="noopener noreferrer">Game Content Usage Rules</a>
            using assets from Age of Empires II and is not endorsed by or affiliated with Microsoft.
        </footer>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private AgeNexus.Infrastructure.Identity.PublicProfile? CurrentProfile { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authentication = await AuthenticationStateTask;
        if (authentication.User.Identity?.IsAuthenticated == true)
        {
            CurrentProfile = await Accounts.GetProfileAsync(authentication.User, CancellationToken.None);
        }
    }
}
