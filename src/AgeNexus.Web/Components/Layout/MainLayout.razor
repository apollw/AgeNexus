@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="Age Nexus - início">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48" role="img">
                    <path d="M24 4 41 14v20L24 44 7 34V14L24 4Z" />
                    <path d="m16 31 8-16 8 16M19 26h10" />
                </svg>
            </span>
            <span><strong>AGE</strong><b>NEXUS</b></span>
        </a>

        <NavMenu />

    </aside>

    <div class="main-column">
        <header class="topbar">
            <div class="mobile-brand">AGE <span>NEXUS</span></div>
            <div class="topbar-actions">
                <button class="icon-button" type="button" title="Notificações" aria-label="Notificações">
                    <svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                </button>
                <AuthorizeView>
                    <Authorized Context="session">
                        <a class="button button-primary button-compact" href="/partidas">
                            <span>+</span> Registrar partida
                        </a>
                        <a class="profile-chip" href="/perfil">
                            <span class="avatar">@GetInitial(session.User.Identity?.Name)</span>
                            <span class="profile-copy"><strong>@session.User.Identity?.Name</strong><small>Minha conta</small></span>
                        </a>
                        <form method="post" action="/account/logout" class="logout-form">
                            <AntiforgeryToken />
                            <button class="logout-button" type="submit">Sair</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="topbar-link" href="/conta/login">Entrar</a>
                        <a class="button button-primary button-compact" href="/conta/criar">Criar conta</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    private static string GetInitial(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "?" : value[..1].ToUpperInvariant();
}

